# HiTechPay deployment settings — copy to deploy/.env and adjust.
HTP_VERSION=latest
HTP_REGISTRY=hitechpay
HTP_RUN_ENV=sandbox

# Public URLs (used for redirects, webhooks and the dashboard)
HTP_API_PUBLIC_URL=http://localhost:8080
HTP_DASHBOARD_PUBLIC_URL=http://localhost:9000

# Ports
HTP_API_PORT=8080
HTP_DASHBOARD_PORT=9000
HTP_SDK_PORT=9050
HTP_HTTP_PORT=80
HTP_PG_PORT=5432

# Database
HTP_DB_USER=db_user
HTP_DB_PASSWORD=db_pass
HTP_DB_NAME=hyperswitch_db

# Secrets — CHANGE ALL OF THESE IN PRODUCTION
# master key: 32 random bytes hex encoded (openssl rand -hex 32)
HTP_ADMIN_API_KEY=test_admin
HTP_JWT_SECRET=change-me-jwt-secret
HTP_MASTER_ENC_KEY=73ad7bbbbc640c845a150f67d058b279849370cd2c1f3c67c4dd6c869213e13a

# Extra cargo features for the router image (e.g. "release" builds use upstream defaults)
HTP_ROUTER_EXTRA_FEATURES=
