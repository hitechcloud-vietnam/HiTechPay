{
    "name": "hitechpay/hitechpay-php",
    "description": "Official PHP server SDK for HiTechPay (Hyperswitch-compatible payments API) with Vietnam helpers (VietQR, MoMo, VND).",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["hitechpay", "hyperswitch", "payments", "vietqr", "momo", "vietnam", "napas"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "HiTechPay\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
