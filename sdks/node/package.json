{
  "name": "@hitechpay/node",
  "version": "0.1.0",
  "description": "Official Node.js server SDK for HiTechPay (Hyperswitch-compatible payments API) with Vietnam helpers (VietQR, MoMo, VND).",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "hitechpay",
    "hyperswitch",
    "payments",
    "vietqr",
    "momo",
    "vietnam",
    "napas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"for (const d of ['dist','.test-build']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .test-build/test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.4.0"
  }
}
