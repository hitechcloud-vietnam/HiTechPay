+    pub vnp_TransactionStatus: Option<String>,
+    pub vnp_SecureHash: Option<String>,
+}
+
+impl VnpayTransactionData {
+    pub fn from_query(query: &str) -> Self {
+        let map: BTreeMap<String, String> = url::form_urlencoded::parse(query.as_bytes())
+            .into_owned()
+            .collect();
+        serde_json::to_value(&map)
+            .ok()
+            .and_then(|value| serde_json::from_value(value).ok())
+            .unwrap_or_default()
+    }
+}
+
+/// `vnp_TransactionStatus` / IPN `vnp_ResponseCode` → attempt status
+pub fn attempt_status(data: &VnpayTransactionData) -> enums::AttemptStatus {
+    let is_query = data.vnp_Command.as_deref() == Some("querydr");
+    if is_query && data.vnp_ResponseCode.as_deref() != Some("00") {
+        // "91": transaction not found yet (customer has not paid)
+        return match data.vnp_ResponseCode.as_deref() {
+            Some("91") | Some("94") => enums::AttemptStatus::AuthenticationPending,
+            _ => enums::AttemptStatus::Pending,
+        };
+    }
+    let status = data
+        .vnp_TransactionStatus
+        .as_deref()
+        .or(data.vnp_ResponseCode.as_deref());
+    match status {
+        Some("00") => enums::AttemptStatus::Charged,
+        Some("01") => enums::AttemptStatus::AuthenticationPending,
+        Some("04") | Some("05") | Some("06") | Some("09") => enums::AttemptStatus::Charged,
+        Some("07") => enums::AttemptStatus::Pending,
+        Some("24") => enums::AttemptStatus::AuthenticationFailed,
+        _ => enums::AttemptStatus::Failure,
+    }
+}
+
+impl<F, T> TryFrom<ResponseRouterData<F, VnpayTransactionData, T, PaymentsResponseData>>
+    for RouterData<F, T, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, VnpayTransactionData, T, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let data = item.response;
+        let status = attempt_status(&data);
+        if matches!(
+            status,
+            enums::AttemptStatus::Failure | enums::AttemptStatus::AuthenticationFailed
+        ) {
+            let code = data
+                .vnp_TransactionStatus
+                .clone()
+                .or(data.vnp_ResponseCode.clone())
+                .unwrap_or_default();
+            return Ok(Self {
+                status,
+                response: Err(ErrorResponse {
+                    code: code.clone(),
+                    message: data
+                        .vnp_Message
+                        .clone()
+                        .unwrap_or_else(|| response_code_message(&code).to_string()),
+                    reason: Some(response_code_message(&code).to_string()),
+                    status_code: item.http_code,
+                    attempt_status: Some(status),
+                    connector_transaction_id: data.vnp_TransactionNo.clone(),
+                    connector_response_reference_id: data.vnp_TxnRef.clone(),
+                    network_advice_code: None,
+                    network_decline_code: None,
+                    network_error_message: None,
+                    connector_metadata: None,
+                }),
+                ..item.data
+            });
+        }
+        let resource_id = match data
+            .vnp_TransactionNo
+            .as_ref()
+            .filter(|no| !no.is_empty() && no.as_str() != "0")
+        {
+            Some(transaction_no) => ResponseId::ConnectorTransactionId(transaction_no.clone()),
+            None => data
+                .vnp_TxnRef
+                .clone()
+                .map(ResponseId::ConnectorTransactionId)
+                .unwrap_or(ResponseId::NoResponseId),
+        };
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id,
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: data.vnp_TxnRef,
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+/// Human readable VNPAY response codes
+pub fn response_code_message(code: &str) -> &'static str {
+    match code {
+        "00" => "Giao dich thanh cong",
+        "07" => "Tru tien thanh cong, giao dich bi nghi ngo",
+        "09" => "The/Tai khoan chua dang ky InternetBanking",
+        "10" => "Xac thuc thong tin the/tai khoan khong dung qua 3 lan",
+        "11" => "Da het han cho thanh toan",
+        "12" => "The/Tai khoan bi khoa",
+        "13" => "Nhap sai mat khau xac thuc giao dich (OTP)",
+        "24" => "Khach hang huy giao dich",
+        "51" => "Tai khoan khong du so du",
+        "65" => "Tai khoan vuot qua han muc giao dich trong ngay",
+        "75" => "Ngan hang thanh toan dang bao tri",
+        "79" => "Nhap sai mat khau thanh toan qua so lan quy dinh",
+        "91" => "Khong tim thay giao dich yeu cau",
+        "94" => "Yeu cau bi trung lap",
+        "97" => "Chu ky khong hop le",
+        "99" => "Loi khong xac dinh",
+        _ => "Giao dich khong thanh cong",
+    }
+}
