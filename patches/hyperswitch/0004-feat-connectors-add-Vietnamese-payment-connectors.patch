+
+/// Verify the `vnp_SecureHash` of an IPN / return URL query string.
+pub fn verify_query_signature(auth: &VnpayAuthType, query: &str) -> bool {
+    let params: BTreeMap<String, String> = url::form_urlencoded::parse(query.as_bytes())
+        .into_owned()
+        .collect();
+    let Some(received) = params.get("vnp_SecureHash") else {
+        return false;
+    };
+    let canonical = canonical_query(&params);
+    auth.sign(&canonical)
+        .map(|expected| vn_utils::secure_eq(&expected, &received.to_ascii_lowercase()))
+        .unwrap_or(false)
+}
