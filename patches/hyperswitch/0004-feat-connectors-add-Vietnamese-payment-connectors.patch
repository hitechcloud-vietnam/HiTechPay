+        let refund_status = match (
+            item.response.vnp_ResponseCode.as_deref(),
+            item.response.vnp_TransactionType.as_deref(),
+        ) {
+            (Some("00"), Some("02") | Some("03")) => refund_status(&item.response),
+            _ => enums::RefundStatus::Pending,
+        };
+        Ok(Self {
+            response: Ok(RefundsResponseData {
+                connector_refund_id,
+                refund_status,
+            }),
+            ..item.data
+        })
+    }
+}
