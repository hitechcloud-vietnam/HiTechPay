+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn create_signature_matches_momo_sample() {
+        // Sample credentials published in MoMo's developer docs (test environment)
+        let raw = create_signature_raw(
+            "F8BBA842ECF85",
+            MinorUnit::new(50000),
+            "",
+            "https://webhook.site/b3088a6a-2d17-4f8d-a383-71389a6c600b",
+            "MOMO1540456472575",
+            "pay with MoMo",
+            "MOMO",
+            "https://momo.vn/return",
+            "MOMO1540456472575",
+            "captureWallet",
+        );
+        assert_eq!(
+            raw,
+            "accessKey=F8BBA842ECF85&amount=50000&extraData=&ipnUrl=https://webhook.site/b3088a6a-2d17-4f8d-a383-71389a6c600b&orderId=MOMO1540456472575&orderInfo=pay with MoMo&partnerCode=MOMO&redirectUrl=https://momo.vn/return&requestId=MOMO1540456472575&requestType=captureWallet"
+        );
+        let signature =
+            vn_utils::hmac_sha256_hex("K951B6PE1waDMi640xX08PD3vg6EkVlz", &raw).unwrap();
+        assert_eq!(signature.len(), 64);
+    }
+
+    #[test]
+    fn maps_result_codes() {
+        assert_eq!(
+            attempt_status_from_result_code(0),
+            enums::AttemptStatus::Charged
+        );
+        assert_eq!(
+            attempt_status_from_result_code(9000),
+            enums::AttemptStatus::Authorized
+        );
+        assert_eq!(
+            attempt_status_from_result_code(7000),
+            enums::AttemptStatus::Pending
+        );
+        assert_eq!(
+            attempt_status_from_result_code(1006),
+            enums::AttemptStatus::AuthenticationFailed
+        );
+        assert_eq!(
+            attempt_status_from_result_code(1001),
+            enums::AttemptStatus::Failure
+        );
+    }
+
+    #[test]
+    fn parses_ipn() {
+        let body = r#"{"partnerCode":"MOMO","orderId":"pay_1","requestId":"pay_1","amount":10000,"orderInfo":"x","orderType":"momo_wallet","transId":4088878653,"resultCode":0,"message":"Successful.","payType":"qr","responseTime":1721720663942,"extraData":"","signature":"abc"}"#;
+        let ipn: MomoTransactionResponse = serde_json::from_str(body).unwrap();
+        assert_eq!(ipn.trans_id, Some(4088878653));
+        assert_eq!(
+            ipn_signature_raw("AK", &ipn),
