@@ -0,0 +1,748 @@
+//! ZaloPay (API v2) transformers.
+//!
+//! API reference: <https://docs.zalopay.vn/v2/>
+//! * create       : `POST /v2/create`        mac = HMAC_SHA256(key1, app_id|app_trans_id|app_user|amount|app_time|embed_data|item)
+//! * query        : `POST /v2/query`         mac = HMAC_SHA256(key1, app_id|app_trans_id|key1)
+//! * refund       : `POST /v2/refund`        mac = HMAC_SHA256(key1, app_id|zp_trans_id|amount|description|timestamp)
+//! * query refund : `POST /v2/query_refund`  mac = HMAC_SHA256(key1, app_id|m_refund_id|timestamp)
+//! * callback     : `POST <callback_url>` `{data, mac, type}`, mac = HMAC_SHA256(key2, data)
+
+use common_enums::enums;
+use common_utils::types::MinorUnit;
+use error_stack::ResultExt;
+use hyperswitch_domain_models::{
+    payment_method_data::{BankRedirectData, PaymentMethodData, RealTimePaymentData},
+    router_data::{ConnectorAuthType, ErrorResponse, RouterData},
+    router_flow_types::refunds::{Execute, RSync},
+    router_request_types::ResponseId,
+    router_response_types::{PaymentsResponseData, RedirectForm, RefundsResponseData},
+    types::{PaymentsAuthorizeRouterData, PaymentsSyncRouterData, RefundsRouterData},
+};
+use hyperswitch_interfaces::errors;
+use hyperswitch_masking::{PeekInterface, Secret};
+use serde::{Deserialize, Serialize};
+
+use crate::{
+    types::{RefundsResponseRouterData, ResponseRouterData},
+    utils::PaymentsAuthorizeRequestData,
+    vn_utils,
+};
+
+const MAX_APP_TRANS_ID_LEN: usize = 40;
+const MAX_REFUND_ID_LEN: usize = 45;
+const DEFAULT_APP_USER: &str = "HiTechPay";
+
+pub mod return_code {
+    pub const SUCCESS: i64 = 1;
+    pub const FAILED: i64 = 2;
+    pub const PROCESSING: i64 = 3;
+}
+
+pub struct ZalopayRouterData<T> {
+    pub amount: MinorUnit,
+    pub router_data: T,
+}
+
+impl<T> From<(MinorUnit, T)> for ZalopayRouterData<T> {
+    fn from((amount, item): (MinorUnit, T)) -> Self {
+        Self {
+            amount,
+            router_data: item,
+        }
+    }
+}
+
+pub struct ZalopayAuthType {
+    pub app_id: Secret<String>,
+    pub key1: Secret<String>,
+    pub key2: Secret<String>,
+}
+
+impl TryFrom<&ConnectorAuthType> for ZalopayAuthType {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(auth_type: &ConnectorAuthType) -> Result<Self, Self::Error> {
+        match auth_type {
+            ConnectorAuthType::SignatureKey {
+                api_key,
+                key1,
+                api_secret,
+            } => Ok(Self {
+                app_id: api_key.to_owned(),
+                key1: key1.to_owned(),
+                key2: api_secret.to_owned(),
+            }),
+            _ => Err(errors::ConnectorError::FailedToObtainAuthType.into()),
+        }
+    }
+}
+
+impl ZalopayAuthType {
+    pub fn mac_key1(
+        &self,
+        data: &str,
+    ) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+        vn_utils::hmac_sha256_hex(self.key1.peek(), data)
+    }
+
+    pub fn app_id_number(&self) -> Result<i64, error_stack::Report<errors::ConnectorError>> {
+        self.app_id.peek().trim().parse::<i64>().change_context(
+            errors::ConnectorError::InvalidConnectorConfig {
+                config: "app_id must be numeric",
+            },
+        )
+    }
+}
+
+fn now_millis() -> i64 {
+    let now = time::OffsetDateTime::now_utc();
+    now.unix_timestamp() * 1000 + i64::from(now.millisecond())
+}
+
+fn alnum(input: &str) -> String {
+    input
+        .chars()
+        .filter(|c| c.is_ascii_alphanumeric())
+        .collect()
+}
+
+/// `yymmdd_<reference>`; falls back to a hash when the reference is too long.
+pub fn build_app_trans_id(date_prefix: &str, reference: &str) -> String {
+    let candidate = format!("{date_prefix}_{reference}");
+    if candidate.len() <= MAX_APP_TRANS_ID_LEN {
+        candidate
+    } else {
+        format!("{date_prefix}_{}", vn_utils::transfer_code(reference))
+    }
+}
+
+/// `yymmdd_appid_<refund reference>` as required by ZaloPay
+pub fn build_m_refund_id(date_prefix: &str, app_id: &str, refund_reference: &str) -> String {
+    let candidate = format!("{date_prefix}_{app_id}_{}", alnum(refund_reference));
+    if candidate.len() <= MAX_REFUND_ID_LEN {
+        candidate
+    } else {
+        format!(
+            "{date_prefix}_{app_id}_{}",
+            vn_utils::transfer_code(refund_reference)
+        )
+    }
+}
+
+/// Stored on the payment attempt
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayConnectorMetadata {
+    pub app_trans_id: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayEmbedData {
+    pub redirecturl: String,
+    pub preferred_payment_method: Vec<String>,
+    /// HiTechPay attempt reference, echoed back in the callback
+    pub hitechpay_ref: String,
+}
+
+#[derive(Debug, Serialize)]
+pub struct ZalopayPaymentsRequest {
+    pub app_id: i64,
+    pub app_user: String,
+    pub app_trans_id: String,
+    pub app_time: i64,
+    pub expire_duration_seconds: i64,
+    pub amount: i64,
+    pub item: String,
+    pub embed_data: String,
+    pub description: String,
+    pub bank_code: String,
+    pub callback_url: String,
+    pub mac: String,
+}
+
+impl TryFrom<&ZalopayRouterData<&PaymentsAuthorizeRouterData>> for ZalopayPaymentsRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: &ZalopayRouterData<&PaymentsAuthorizeRouterData>,
+    ) -> Result<Self, Self::Error> {
+        let router_data = item.router_data;
+        if router_data.request.currency != enums::Currency::VND {
+            Err(errors::ConnectorError::NotSupported {
+                message: format!("currency {}", router_data.request.currency),
+                connector: "zalopay",
+            })?
+        }
+        let preferred_payment_method = match &router_data.request.payment_method_data {
+            PaymentMethodData::RealTimePayment(rtp) => match rtp.as_ref() {
+                RealTimePaymentData::VietQr {} => vec!["vietqr".to_string()],
+                _ => Err(errors::ConnectorError::NotImplemented(
+                    crate::utils::get_unimplemented_payment_method_error_message("zalopay"),
+                ))?,
+            },
+            PaymentMethodData::BankRedirect(BankRedirectData::LocalBankRedirect {}) => vec![],
+            _ => Err(errors::ConnectorError::NotImplemented(
+                crate::utils::get_unimplemented_payment_method_error_message("zalopay"),
+            ))?,
+        };
+        let auth = ZalopayAuthType::try_from(&router_data.connector_auth_type)?;
+        let app_id = auth.app_id_number()?;
+        let reference = router_data.connector_request_reference_id.clone();
+        let app_trans_id =
+            build_app_trans_id(&vn_utils::format_yymmdd(vn_utils::now_vn()), &reference);
+        let app_time = now_millis();
+        let app_user = router_data
+            .customer_id
+            .as_ref()
+            .map(|id| id.get_string_repr().to_string())
+            .unwrap_or_else(|| DEFAULT_APP_USER.to_string());
+        let embed_data = serde_json::to_string(&ZalopayEmbedData {
+            redirecturl: router_data.request.get_router_return_url()?,
+            preferred_payment_method,
+            hitechpay_ref: reference.clone(),
+        })
+        .change_context(errors::ConnectorError::RequestEncodingFailed)?;
+        let item_json = "[]".to_string();
+        let amount = item.amount.get_amount_as_i64();
+        let mac = auth.mac_key1(&format!(
+            "{app_id}|{app_trans_id}|{app_user}|{amount}|{app_time}|{embed_data}|{item_json}"
+        ))?;
+        Ok(Self {
+            app_id,
+            app_user,
+            app_trans_id,
+            app_time,
+            expire_duration_seconds: 15 * 60,
+            amount,
+            item: item_json,
+            embed_data,
+            description: vn_utils::sanitize_memo(
+                &router_data
+                    .description
+                    .clone()
+                    .unwrap_or_else(|| format!("Thanh toan don hang {reference}")),
+                256,
+            ),
+            bank_code: String::new(),
+            callback_url: router_data.request.get_webhook_url()?,
+            mac,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayPaymentsResponse {
+    pub return_code: i64,
+    pub return_message: Option<String>,
+    pub sub_return_code: Option<i64>,
+    pub sub_return_message: Option<String>,
+    pub order_url: Option<String>,
+    pub zp_trans_token: Option<String>,
+    pub order_token: Option<String>,
+    pub qr_code: Option<String>,
+}
+
+fn error_response(
+    code: Option<i64>,
+    message: Option<String>,
+    http_code: u16,
+    attempt_status: Option<enums::AttemptStatus>,
+) -> ErrorResponse {
+    ErrorResponse {
+        code: code
+            .map(|c| c.to_string())
+            .unwrap_or_else(|| hyperswitch_interfaces::consts::NO_ERROR_CODE.to_string()),
+        message: message
+            .clone()
+            .unwrap_or_else(|| "ZaloPay transaction failed".to_string()),
+        reason: message,
+        status_code: http_code,
+        attempt_status,
+        connector_transaction_id: None,
+        connector_response_reference_id: None,
+        network_advice_code: None,
+        network_decline_code: None,
+        network_error_message: None,
+        connector_metadata: None,
+    }
+}
+
+impl
+    TryFrom<
+        ResponseRouterData<
+            hyperswitch_domain_models::router_flow_types::payments::Authorize,
+            ZalopayPaymentsResponse,
+            hyperswitch_domain_models::router_request_types::PaymentsAuthorizeData,
+            PaymentsResponseData,
+        >,
+    > for PaymentsAuthorizeRouterData
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<
+            hyperswitch_domain_models::router_flow_types::payments::Authorize,
+            ZalopayPaymentsResponse,
+            hyperswitch_domain_models::router_request_types::PaymentsAuthorizeData,
+            PaymentsResponseData,
+        >,
+    ) -> Result<Self, Self::Error> {
+        let response = item.response;
+        if response.return_code != return_code::SUCCESS {
+            let code = response.sub_return_code.or(Some(response.return_code));
+            let message = response.sub_return_message.or(response.return_message);
+            return Ok(Self {
+                status: enums::AttemptStatus::Failure,
+                response: Err(error_response(
+                    code,
+                    message,
+                    item.http_code,
+                    Some(enums::AttemptStatus::Failure),
+                )),
+                ..item.data
+            });
+        }
+        let order_url = response
+            .order_url
+            .ok_or(errors::ConnectorError::MissingRequiredField {
+                field_name: "order_url".into(),
+            })?;
+        let redirection_url =
+            url::Url::parse(&order_url).change_context(errors::ConnectorError::ParsingFailed)?;
+        // The request is rebuilt to know the app_trans_id that was sent
+        let app_trans_id = build_app_trans_id(
+            &vn_utils::format_yymmdd(vn_utils::now_vn()),
+            &item.data.connector_request_reference_id,
+        );
+        let mut connector_metadata = serde_json::to_value(ZalopayConnectorMetadata {
+            app_trans_id: app_trans_id.clone(),
+        })
+        .change_context(errors::ConnectorError::ResponseHandlingFailed)?;
+        if let Some(qr) = response.qr_code.filter(|qr| !qr.is_empty()) {
+            let qr_meta = vn_utils::qr_code_metadata(qr, None, None)?;
+            if let (Some(target), Some(source)) =
+                (connector_metadata.as_object_mut(), qr_meta.as_object())
+            {
+                target.extend(source.clone());
+            }
+        }
+        Ok(Self {
+            status: enums::AttemptStatus::AuthenticationPending,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id: ResponseId::ConnectorTransactionId(app_trans_id.clone()),
+                redirection_data: Box::new(Some(RedirectForm::from((
+                    redirection_url,
+                    common_utils::request::Method::Get,
+                )))),
+                mandate_reference: Box::new(None),
+                connector_metadata: Some(connector_metadata),
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: Some(app_trans_id),
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+// ---------------------------------------------------------------------------
+// PSync
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Serialize)]
+pub struct ZalopayQueryRequest {
+    pub app_id: i64,
+    pub app_trans_id: String,
+    pub mac: String,
+}
+
+pub fn app_trans_id_from_sync(item: &PaymentsSyncRouterData) -> Option<String> {
+    item.request
+        .connector_meta
+        .as_ref()
+        .and_then(|meta| serde_json::from_value::<ZalopayConnectorMetadata>(meta.clone()).ok())
+        .map(|meta| meta.app_trans_id)
+        .or_else(|| {
+            item.request
+                .connector_transaction_id
+                .get_connector_transaction_id()
+                .ok()
+                .filter(|id| id.contains('_'))
+        })
+}
+
+impl TryFrom<&PaymentsSyncRouterData> for ZalopayQueryRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(item: &PaymentsSyncRouterData) -> Result<Self, Self::Error> {
+        let auth = ZalopayAuthType::try_from(&item.connector_auth_type)?;
+        let app_id = auth.app_id_number()?;
+        let app_trans_id = app_trans_id_from_sync(item)
+            .ok_or(errors::ConnectorError::MissingConnectorTransactionID)?;
+        let mac = auth.mac_key1(&format!("{app_id}|{app_trans_id}|{}", auth.key1.peek()))?;
+        Ok(Self {
+            app_id,
+            app_trans_id,
+            mac,
+        })
+    }
+}
+
+/// Response of `/v2/query`; webhook callbacks are converted into this shape too.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayQueryResponse {
+    pub return_code: i64,
+    pub return_message: Option<String>,
+    pub sub_return_code: Option<i64>,
+    pub sub_return_message: Option<String>,
+    pub is_processing: Option<bool>,
+    pub amount: Option<i64>,
+    pub zp_trans_id: Option<i64>,
+}
+
+pub fn attempt_status(response: &ZalopayQueryResponse) -> enums::AttemptStatus {
+    match response.return_code {
+        return_code::SUCCESS => enums::AttemptStatus::Charged,
+        return_code::PROCESSING => {
+            if response.is_processing == Some(true) {
+                enums::AttemptStatus::Pending
+            } else {
+                enums::AttemptStatus::AuthenticationPending
+            }
+        }
+        _ => enums::AttemptStatus::Failure,
+    }
+}
+
+impl<F, T> TryFrom<ResponseRouterData<F, ZalopayQueryResponse, T, PaymentsResponseData>>
+    for RouterData<F, T, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, ZalopayQueryResponse, T, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let response = item.response;
+        let status = attempt_status(&response);
+        if status == enums::AttemptStatus::Failure {
+            return Ok(Self {
+                status,
+                response: Err(error_response(
+                    response.sub_return_code.or(Some(response.return_code)),
+                    response.sub_return_message.or(response.return_message),
+                    item.http_code,
+                    Some(status),
+                )),
+                ..item.data
+            });
+        }
+        let resource_id = match response.zp_trans_id.filter(|id| *id > 0) {
+            Some(zp_trans_id) => ResponseId::ConnectorTransactionId(zp_trans_id.to_string()),
+            None => ResponseId::NoResponseId,
+        };
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id,
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: None,
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Refunds
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Serialize)]
+pub struct ZalopayRefundRequest {
+    pub app_id: i64,
+    pub m_refund_id: String,
+    pub zp_trans_id: String,
+    pub amount: i64,
+    pub timestamp: i64,
+    pub description: String,
+    pub mac: String,
+}
+
+impl TryFrom<&ZalopayRouterData<&RefundsRouterData<Execute>>> for ZalopayRefundRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: &ZalopayRouterData<&RefundsRouterData<Execute>>,
+    ) -> Result<Self, Self::Error> {
+        let router_data = item.router_data;
+        let auth = ZalopayAuthType::try_from(&router_data.connector_auth_type)?;
+        let app_id = auth.app_id_number()?;
+        let zp_trans_id = router_data.request.connector_transaction_id.clone();
+        if zp_trans_id.parse::<i64>().is_err() {
+            Err(errors::ConnectorError::MissingConnectorTransactionID).attach_printable(
+                "ZaloPay zp_trans_id is not available yet, sync the payment first",
+            )?
+        }
+        let m_refund_id = build_m_refund_id(
+            &vn_utils::format_yymmdd(vn_utils::now_vn()),
+            auth.app_id.peek(),
+            &router_data.request.refund_id,
+        );
+        let amount = item.amount.get_amount_as_i64();
+        let timestamp = now_millis();
+        let description = vn_utils::sanitize_memo(
+            router_data
+                .request
+                .reason
+                .as_deref()
+                .unwrap_or("Hoan tien giao dich"),
+            100,
+        );
+        let mac = auth.mac_key1(&format!(
+            "{app_id}|{zp_trans_id}|{amount}|{description}|{timestamp}"
+        ))?;
+        Ok(Self {
+            app_id,
+            m_refund_id,
+            zp_trans_id,
+            amount,
+            timestamp,
+            description,
+            mac,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayRefundResponse {
+    pub return_code: i64,
+    pub return_message: Option<String>,
+    pub sub_return_code: Option<i64>,
+    pub sub_return_message: Option<String>,
+    pub refund_id: Option<i64>,
+}
+
+fn refund_status(return_code: i64) -> enums::RefundStatus {
+    match return_code {
+        return_code::SUCCESS => enums::RefundStatus::Success,
+        return_code::PROCESSING => enums::RefundStatus::Pending,
+        _ => enums::RefundStatus::Failure,
+    }
+}
+
+impl TryFrom<RefundsResponseRouterData<Execute, ZalopayRefundResponse>>
+    for RefundsRouterData<Execute>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: RefundsResponseRouterData<Execute, ZalopayRefundResponse>,
+    ) -> Result<Self, Self::Error> {
+        let status = refund_status(item.response.return_code);
+        if status == enums::RefundStatus::Failure {
+            return Ok(Self {
+                response: Err(error_response(
+                    item.response
+                        .sub_return_code
+                        .or(Some(item.response.return_code)),
+                    item.response
+                        .sub_return_message
+                        .or(item.response.return_message),
+                    item.http_code,
+                    None,
+                )),
+                ..item.data
+            });
+        }
+        let auth = ZalopayAuthType::try_from(&item.data.connector_auth_type)?;
+        // m_refund_id is what refund queries need; rebuild it deterministically
+        let m_refund_id = build_m_refund_id(
+            &vn_utils::format_yymmdd(vn_utils::now_vn()),
+            auth.app_id.peek(),
+            &item.data.request.refund_id,
+        );
+        Ok(Self {
+            response: Ok(RefundsResponseData {
+                connector_refund_id: m_refund_id,
+                refund_status: status,
+            }),
+            ..item.data
+        })
+    }
+}
+
+#[derive(Debug, Serialize)]
+pub struct ZalopayRefundQueryRequest {
+    pub app_id: i64,
+    pub m_refund_id: String,
+    pub timestamp: i64,
+    pub mac: String,
+}
+
+impl TryFrom<&RefundsRouterData<RSync>> for ZalopayRefundQueryRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(item: &RefundsRouterData<RSync>) -> Result<Self, Self::Error> {
+        let auth = ZalopayAuthType::try_from(&item.connector_auth_type)?;
+        let app_id = auth.app_id_number()?;
+        let m_refund_id = item
+            .request
+            .connector_refund_id
+            .clone()
+            .ok_or(errors::ConnectorError::MissingConnectorRefundID)?;
+        let timestamp = now_millis();
+        let mac = auth.mac_key1(&format!("{app_id}|{m_refund_id}|{timestamp}"))?;
+        Ok(Self {
+            app_id,
+            m_refund_id,
+            timestamp,
+            mac,
+        })
+    }
+}
+
+impl TryFrom<RefundsResponseRouterData<RSync, ZalopayRefundResponse>> for RefundsRouterData<RSync> {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: RefundsResponseRouterData<RSync, ZalopayRefundResponse>,
+    ) -> Result<Self, Self::Error> {
+        let connector_refund_id = item
+            .data
+            .request
+            .connector_refund_id
+            .clone()
+            .unwrap_or_else(|| item.data.request.refund_id.clone());
+        Ok(Self {
+            response: Ok(RefundsResponseData {
+                connector_refund_id,
+                refund_status: refund_status(item.response.return_code),
+            }),
+            ..item.data
+        })
+    }
+}
