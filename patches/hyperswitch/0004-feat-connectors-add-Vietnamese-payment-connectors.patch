+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    fn auth() -> VnpayAuthType {
+        VnpayAuthType {
+            tmn_code: Secret::new("DEMOV210".to_string()),
+            hash_secret: Secret::new("SECRETKEY123".to_string()),
+        }
+    }
+
+    #[test]
+    fn php_urlencode_matches_php() {
+        assert_eq!(php_urlencode("Thanh toan don 1"), "Thanh+toan+don+1");
+        assert_eq!(
+            php_urlencode("https://a.b/c?d=1"),
+            "https%3A%2F%2Fa.b%2Fc%3Fd%3D1"
+        );
+        assert_eq!(php_urlencode("a*b~c"), "a%2Ab%7Ec");
+    }
+
+    #[test]
+    fn canonical_query_is_sorted_and_skips_hash() {
+        let mut params = BTreeMap::new();
+        params.insert("vnp_TxnRef".to_string(), "1".to_string());
+        params.insert("vnp_Amount".to_string(), "1000000".to_string());
+        params.insert("vnp_SecureHash".to_string(), "x".to_string());
+        params.insert("vnp_BankCode".to_string(), String::new());
+        assert_eq!(canonical_query(&params), "vnp_Amount=1000000&vnp_TxnRef=1");
+    }
+
+    #[test]
+    fn verifies_ipn_signature() {
+        let auth = auth();
+        let unsigned = "vnp_Amount=1000000&vnp_BankCode=NCB&vnp_OrderInfo=Thanh+toan+don+hang&vnp_ResponseCode=00&vnp_TmnCode=DEMOV210&vnp_TransactionNo=14422574&vnp_TransactionStatus=00&vnp_TxnRef=pay_1";
+        let hash = auth.sign(unsigned).unwrap();
+        let query = format!("{unsigned}&vnp_SecureHashType=HmacSHA512&vnp_SecureHash={hash}");
+        assert!(verify_query_signature(&auth, &query));
+        let tampered = query.replace("vnp_Amount=1000000", "vnp_Amount=1");
+        assert!(!verify_query_signature(&auth, &tampered));
+        let data = VnpayTransactionData::from_query(&query);
+        assert_eq!(data.vnp_TxnRef.as_deref(), Some("pay_1"));
+        assert_eq!(attempt_status(&data), enums::AttemptStatus::Charged);
+    }
+
+    #[test]
+    fn maps_querydr_statuses() {
+        let mut data = VnpayTransactionData {
+            vnp_Command: Some("querydr".to_string()),
+            vnp_ResponseCode: Some("91".to_string()),
+            ..Default::default()
+        };
+        assert_eq!(
+            attempt_status(&data),
+            enums::AttemptStatus::AuthenticationPending
+        );
+        data.vnp_ResponseCode = Some("00".to_string());
+        data.vnp_TransactionStatus = Some("02".to_string());
+        assert_eq!(attempt_status(&data), enums::AttemptStatus::Failure);
+        data.vnp_TransactionStatus = Some("00".to_string());
+        assert_eq!(attempt_status(&data), enums::AttemptStatus::Charged);
+    }
+}
