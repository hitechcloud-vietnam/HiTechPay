+    pub request_id: Option<String>,
+    pub amount: Option<i64>,
+    pub trans_id: Option<i64>,
+    pub result_code: i64,
+    pub message: Option<String>,
+}
+
+fn refund_status_from_result_code(code: i64) -> enums::RefundStatus {
+    match code {
+        result_code::SUCCESS => enums::RefundStatus::Success,
+        result_code::INITIATED
+        | result_code::PENDING_CONFIRM
+        | result_code::PROCESSING
+        | result_code::PENDING_USER => enums::RefundStatus::Pending,
+        _ => enums::RefundStatus::Failure,
+    }
+}
+
+impl TryFrom<RefundsResponseRouterData<Execute, MomoRefundResponse>>
+    for RefundsRouterData<Execute>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: RefundsResponseRouterData<Execute, MomoRefundResponse>,
+    ) -> Result<Self, Self::Error> {
+        let refund_status = refund_status_from_result_code(item.response.result_code);
+        if refund_status == enums::RefundStatus::Failure {
+            return Ok(Self {
+                response: Err(ErrorResponse {
+                    attempt_status: None,
+                    ..error_response(
+                        item.response.result_code,
+                        item.response.message,
+                        item.http_code,
+                        None,
+                    )
+                }),
+                ..item.data
+            });
+        }
+        let connector_refund_id = item
+            .response
+            .order_id
+            .unwrap_or_else(|| item.data.request.refund_id.clone());
+        Ok(Self {
+            response: Ok(RefundsResponseData {
+                connector_refund_id,
+                refund_status,
+            }),
+            ..item.data
+        })
+    }
+}
+
+/// RSync queries the original payment; MoMo returns every refund in `refundTrans`.
+impl TryFrom<&RefundsRouterData<RSync>> for MomoQueryRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(item: &RefundsRouterData<RSync>) -> Result<Self, Self::Error> {
+        let auth = MomoAuthType::try_from(&item.connector_auth_type)?;
+        let payment_order_id = item
+            .request
+            .payment_connector_request_reference_id
+            .clone()
+            .ok_or(errors::ConnectorError::MissingRequiredField {
+                field_name: "payment_connector_request_reference_id".into(),
+            })?;
+        Self::new(&auth, payment_order_id)
+    }
+}
+
+impl TryFrom<RefundsResponseRouterData<RSync, MomoTransactionResponse>>
+    for RefundsRouterData<RSync>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: RefundsResponseRouterData<RSync, MomoTransactionResponse>,
+    ) -> Result<Self, Self::Error> {
+        let connector_refund_id = item
+            .data
+            .request
+            .connector_refund_id
+            .clone()
+            .unwrap_or_else(|| item.data.request.refund_id.clone());
+        let refund = item
+            .response
+            .refund_trans
+            .iter()
+            .find(|refund| refund.order_id == connector_refund_id);
+        let refund_status = match refund {
+            Some(refund) => refund_status_from_result_code(refund.result_code),
+            None => enums::RefundStatus::Pending,
+        };
+        Ok(Self {
+            response: Ok(RefundsResponseData {
+                connector_refund_id,
+                refund_status,
+            }),
+            ..item.data
+        })
+    }
+}
