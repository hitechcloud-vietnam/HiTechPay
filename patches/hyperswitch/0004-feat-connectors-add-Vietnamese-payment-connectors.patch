+/// Build the signed VNPAY payment URL for an authorize request.
+pub fn build_payment_url(
+    item: &VnpayRouterData<&PaymentsAuthorizeRouterData>,
+) -> Result<(url::Url, VnpayConnectorMetadata), error_stack::Report<errors::ConnectorError>> {
+    let router_data = item.router_data;
+    let base_url = vn_utils::resolve_hosted_payment_url(
+        router_data.connector_meta_data.as_ref(),
+        router_data.test_mode,
+        VNPAY_SANDBOX_PAYMENT_URL,
+        VNPAY_PRODUCTION_PAYMENT_URL,
+    );
+    if router_data.request.currency != enums::Currency::VND {
+        Err(errors::ConnectorError::NotSupported {
+            message: format!("currency {}", router_data.request.currency),
+            connector: "vnpay",
+        })?
+    }
+    let bank_code = match &router_data.request.payment_method_data {
+        PaymentMethodData::RealTimePayment(rtp) => match rtp.as_ref() {
+            RealTimePaymentData::VietQr {} => Some("VNPAYQR"),
+            _ => Err(errors::ConnectorError::NotImplemented(
+                crate::utils::get_unimplemented_payment_method_error_message("vnpay"),
+            ))?,
+        },
+        PaymentMethodData::BankRedirect(BankRedirectData::LocalBankRedirect {}) => None,
+        _ => Err(errors::ConnectorError::NotImplemented(
+            crate::utils::get_unimplemented_payment_method_error_message("vnpay"),
+        ))?,
+    };
+    let auth = VnpayAuthType::try_from(&router_data.connector_auth_type)?;
+    let now = vn_utils::now_vn();
+    let create_date = vn_utils::format_yyyymmddhhmmss(now);
+    let expire_date =
+        vn_utils::format_yyyymmddhhmmss(now + time::Duration::minutes(PAYMENT_EXPIRY_MINUTES));
+    let txn_ref = router_data.connector_request_reference_id.clone();
+    let order_info = vn_utils::sanitize_memo(
+        &router_data
+            .description
+            .clone()
+            .unwrap_or_else(|| format!("Thanh toan don hang {txn_ref}")),
+        255,
+    );
+    let ip_address = router_data
+        .request
+        .get_ip_address_as_optional()
+        .map(|ip| ip.expose())
+        .unwrap_or_else(|| DEFAULT_IP.to_string());
+    let locale = get_locale(
+        router_data
+            .request
+            .browser_info
+            .as_ref()
+            .and_then(|b| b.language.as_ref()),
+    );
+
+    let mut params = BTreeMap::new();
+    params.insert("vnp_Version".to_string(), VNPAY_VERSION.to_string());
+    params.insert("vnp_Command".to_string(), "pay".to_string());
+    params.insert("vnp_TmnCode".to_string(), auth.tmn_code.peek().clone());
+    params.insert(
+        "vnp_Amount".to_string(),
+        (item.amount.get_amount_as_i64() * 100).to_string(),
+    );
+    params.insert("vnp_CurrCode".to_string(), "VND".to_string());
+    params.insert("vnp_TxnRef".to_string(), txn_ref);
+    params.insert("vnp_OrderInfo".to_string(), order_info);
+    params.insert("vnp_OrderType".to_string(), "other".to_string());
+    params.insert("vnp_Locale".to_string(), locale.to_string());
+    params.insert(
+        "vnp_ReturnUrl".to_string(),
+        router_data.request.get_router_return_url()?,
+    );
+    params.insert("vnp_IpAddr".to_string(), ip_address);
+    params.insert("vnp_CreateDate".to_string(), create_date.clone());
+    params.insert("vnp_ExpireDate".to_string(), expire_date);
+    if let Some(bank_code) = bank_code {
+        params.insert("vnp_BankCode".to_string(), bank_code.to_string());
+    }
+
+    let query = canonical_query(&params);
+    let secure_hash = auth.sign(&query)?;
+    let url = url::Url::parse(&format!("{base_url}?{query}&vnp_SecureHash={secure_hash}"))
+        .change_context(errors::ConnectorError::RequestEncodingFailed)?;
+    Ok((
+        url,
+        VnpayConnectorMetadata {
+            vnp_create_date: create_date,
+        },
+    ))
+}
+
+pub fn build_authorize_response(
+    data: &PaymentsAuthorizeRouterData,
+    url: url::Url,
+    metadata: VnpayConnectorMetadata,
+) -> Result<PaymentsAuthorizeRouterData, error_stack::Report<errors::ConnectorError>> {
+    let connector_metadata = serde_json::to_value(metadata)
+        .change_context(errors::ConnectorError::ResponseHandlingFailed)?;
+    let txn_ref = data.connector_request_reference_id.clone();
+    Ok(RouterData {
+        status: enums::AttemptStatus::AuthenticationPending,
+        response: Ok(PaymentsResponseData::TransactionResponse {
+            resource_id: ResponseId::ConnectorTransactionId(txn_ref.clone()),
+            redirection_data: Box::new(Some(RedirectForm::from((
+                url,
+                common_utils::request::Method::Get,
+            )))),
+            mandate_reference: Box::new(None),
+            connector_metadata: Some(connector_metadata),
+            network_txn_id: None,
+            network_txn_link_id: None,
+            connector_response_reference_id: Some(txn_ref),
+            incremental_authorization_allowed: None,
+            authentication_data: None,
+            charges: None,
+            payment_account_reference: None,
+        }),
+        ..data.clone()
+    })
+}
