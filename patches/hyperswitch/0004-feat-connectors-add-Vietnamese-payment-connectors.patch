diff --git a/crates/router/tests/connectors/momo.rs b/crates/router/tests/connectors/momo.rs
new file mode 100644
index 0000000..8f79a2b
--- /dev/null
+++ b/crates/router/tests/connectors/momo.rs
@@ -0,0 +1,64 @@
+//! Momo sandbox tests. Credentials are read from `sample_auth.toml` (`[momo]`);
+//! the tests are ignored by default because they need merchant sandbox credentials.
+use hyperswitch_domain_models::payment_method_data::{
+    MomoRedirection, PaymentMethodData, WalletData,
+};
+use router::types::{self, api, storage::enums};
+use test_utils::connector_auth;
+
+use crate::utils::{self, ConnectorActions};
+
+#[derive(Clone, Copy)]
+struct MomoTest;
+impl ConnectorActions for MomoTest {}
+impl utils::Connector for MomoTest {
+    fn get_data(&self) -> api::ConnectorData {
+        use router::connector::Momo;
+        utils::construct_connector_data_old(
+            Box::new(Momo::new()),
+            types::Connector::Momo,
+            api::GetToken::Connector,
+            None,
+        )
+    }
+
+    fn get_auth_token(&self) -> types::ConnectorAuthType {
+        utils::to_connector_auth_type(
+            connector_auth::ConnectorAuthentication::new()
+                .momo
+                .expect("Missing connector authentication configuration")
+                .into(),
+        )
+    }
+
+    fn get_name(&self) -> String {
+        "momo".to_string()
+    }
+}
+
+static CONNECTOR: MomoTest = MomoTest {};
+
+fn payment_method_details() -> Option<types::PaymentsAuthorizeData> {
+    Some(types::PaymentsAuthorizeData {
+        payment_method_data: PaymentMethodData::Wallet(WalletData::MomoRedirect(
+            MomoRedirection {},
+        )),
+        currency: enums::Currency::VND,
+        amount: 50000,
+        minor_amount: common_utils::types::MinorUnit::new(50000),
+        router_return_url: Some("https://hitechpay.vn/return".to_string()),
+        webhook_url: Some("https://hitechpay.vn/webhooks".to_string()),
+        ..utils::PaymentAuthorizeType::default().0
+    })
+}
+
+/// Authorize calls the sandbox API and returns a customer action (redirect / VietQR).
+#[actix_web::test]
+#[ignore = "requires Momo sandbox credentials"]
+async fn should_create_payment_requiring_customer_action() {
+    let response = CONNECTOR
+        .authorize_payment(payment_method_details(), None)
+        .await
+        .expect("Authorize payment response");
+    assert_eq!(response.status, enums::AttemptStatus::AuthenticationPending);
+}
