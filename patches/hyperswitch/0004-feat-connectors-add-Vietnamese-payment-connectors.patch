+//! MoMo e-wallet (AIO v2) transformers.
+//!
+//! API reference: <https://developers.momo.vn/v3/docs/payment/api/wallet/onetime>
+//! * create  : `POST /v2/gateway/api/create`
+//! * query   : `POST /v2/gateway/api/query`
+//! * refund  : `POST /v2/gateway/api/refund`
+//! * IPN     : `POST <ipnUrl>` (HMAC-SHA256 signature, respond HTTP 204)
+
+use common_enums::enums;
+use common_utils::types::MinorUnit;
+use error_stack::ResultExt;
+use hyperswitch_domain_models::{
+    payment_method_data::{CardRedirectData, PaymentMethodData, WalletData},
+    router_data::{ConnectorAuthType, ErrorResponse, RouterData},
+    router_flow_types::refunds::{Execute, RSync},
+    router_request_types::ResponseId,
+    router_response_types::{PaymentsResponseData, RedirectForm, RefundsResponseData},
+    types::{PaymentsAuthorizeRouterData, PaymentsSyncRouterData, RefundsRouterData},
+};
+use hyperswitch_interfaces::errors;
+use hyperswitch_masking::{PeekInterface, Secret};
+use serde::{Deserialize, Serialize};
+
+use crate::{
+    types::{RefundsResponseRouterData, ResponseRouterData},
+    utils::PaymentsAuthorizeRequestData,
+    vn_utils,
+};
+
+/// MoMo result codes, see <https://developers.momo.vn/v3/docs/payment/api/result-handling/resultcode>
+pub mod result_code {
+    pub const SUCCESS: i64 = 0;
+    pub const AUTHORIZED: i64 = 9000;
+    pub const INITIATED: i64 = 1000;
+    pub const PENDING_CONFIRM: i64 = 7000;
+    pub const PROCESSING: i64 = 7002;
+    pub const PENDING_USER: i64 = 8000;
+    pub const EXPIRED: i64 = 1005;
+    pub const USER_CANCELLED: i64 = 1006;
+}
+
+pub struct MomoRouterData<T> {
+    pub amount: MinorUnit,
+    pub router_data: T,
+}
+
+impl<T> From<(MinorUnit, T)> for MomoRouterData<T> {
+    fn from((amount, item): (MinorUnit, T)) -> Self {
+        Self {
+            amount,
+            router_data: item,
+        }
+    }
+}
+
+pub struct MomoAuthType {
+    pub partner_code: Secret<String>,
+    pub access_key: Secret<String>,
+    pub secret_key: Secret<String>,
+}
+
+impl TryFrom<&ConnectorAuthType> for MomoAuthType {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(auth_type: &ConnectorAuthType) -> Result<Self, Self::Error> {
+        match auth_type {
+            ConnectorAuthType::SignatureKey {
+                api_key,
+                key1,
+                api_secret,
+            } => Ok(Self {
+                partner_code: api_key.to_owned(),
+                access_key: key1.to_owned(),
+                secret_key: api_secret.to_owned(),
+            }),
+            _ => Err(errors::ConnectorError::FailedToObtainAuthType.into()),
+        }
+    }
+}
+
+impl MomoAuthType {
+    pub fn sign(&self, raw: &str) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+        vn_utils::hmac_sha256_hex(self.secret_key.peek(), raw)
+    }
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+pub enum MomoRequestType {
+    #[serde(rename = "captureWallet")]
+    CaptureWallet,
+    #[serde(rename = "payWithATM")]
+    PayWithAtm,
+    #[serde(rename = "payWithMethod")]
+    PayWithMethod,
+}
+
+impl MomoRequestType {
+    fn as_str(&self) -> &'static str {
+        match self {
+            Self::CaptureWallet => "captureWallet",
+            Self::PayWithAtm => "payWithATM",
+            Self::PayWithMethod => "payWithMethod",
+        }
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MomoPaymentsRequest {
+    pub partner_code: Secret<String>,
+    pub request_id: String,
+    pub amount: MinorUnit,
+    pub order_id: String,
+    pub order_info: String,
+    pub redirect_url: String,
+    pub ipn_url: String,
+    pub request_type: MomoRequestType,
+    pub extra_data: String,
+    pub lang: String,
+    pub auto_capture: bool,
+    pub signature: String,
+}
+
+/// Raw signature string of the create request (keys in alphabetical order)
+pub fn create_signature_raw(
+    access_key: &str,
+    amount: MinorUnit,
+    extra_data: &str,
+    ipn_url: &str,
+    order_id: &str,
+    order_info: &str,
+    partner_code: &str,
+    redirect_url: &str,
+    request_id: &str,
+    request_type: &str,
+) -> String {
+    format!(
+        "accessKey={access_key}&amount={}&extraData={extra_data}&ipnUrl={ipn_url}&orderId={order_id}&orderInfo={order_info}&partnerCode={partner_code}&redirectUrl={redirect_url}&requestId={request_id}&requestType={request_type}",
+        amount.get_amount_as_i64()
+    )
+}
+
+fn get_lang(locale: Option<&String>) -> String {
+    match locale.map(|l| l.to_ascii_lowercase()) {
+        Some(locale) if locale.starts_with("en") => "en".to_string(),
+        _ => "vi".to_string(),
+    }
+}
+
+impl TryFrom<&MomoRouterData<&PaymentsAuthorizeRouterData>> for MomoPaymentsRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(item: &MomoRouterData<&PaymentsAuthorizeRouterData>) -> Result<Self, Self::Error> {
+        let router_data = item.router_data;
+        if router_data.request.currency != enums::Currency::VND {
+            Err(errors::ConnectorError::NotSupported {
+                message: format!("currency {}", router_data.request.currency),
+                connector: "momo",
+            })?
+        }
+        let request_type = match &router_data.request.payment_method_data {
+            PaymentMethodData::Wallet(WalletData::MomoRedirect(_)) => {
+                MomoRequestType::CaptureWallet
+            }
+            PaymentMethodData::CardRedirect(CardRedirectData::MomoAtm {}) => {
+                MomoRequestType::PayWithAtm
+            }
+            _ => Err(errors::ConnectorError::NotImplemented(
+                crate::utils::get_unimplemented_payment_method_error_message("momo"),
+            ))?,
+        };
+        let auth = MomoAuthType::try_from(&router_data.connector_auth_type)?;
+        let order_id = router_data.connector_request_reference_id.clone();
+        let request_id = order_id.clone();
+        let order_info = vn_utils::sanitize_memo(
+            &router_data
+                .description
+                .clone()
+                .unwrap_or_else(|| format!("Thanh toan don hang {order_id}")),
+            200,
+        );
+        let redirect_url = router_data.request.get_router_return_url()?;
+        let ipn_url = router_data.request.get_webhook_url()?;
+        let extra_data = String::new();
+        let raw = create_signature_raw(
+            auth.access_key.peek(),
+            item.amount,
+            &extra_data,
+            &ipn_url,
+            &order_id,
+            &order_info,
+            auth.partner_code.peek(),
+            &redirect_url,
+            &request_id,
+            request_type.as_str(),
+        );
+        let signature = auth.sign(&raw)?;
+        Ok(Self {
+            partner_code: auth.partner_code,
+            request_id,
+            amount: item.amount,
+            order_id,
+            order_info,
+            redirect_url,
+            ipn_url,
+            request_type,
+            extra_data,
+            lang: get_lang(
+                router_data
+                    .request
+                    .browser_info
+                    .as_ref()
+                    .and_then(|b| b.language.as_ref()),
+            ),
+            auto_capture: true,
+            signature,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MomoPaymentsResponse {
+    pub partner_code: Option<String>,
+    pub order_id: Option<String>,
+    pub request_id: Option<String>,
+    pub amount: Option<i64>,
+    pub response_time: Option<i64>,
+    pub message: Option<String>,
+    pub result_code: i64,
+    pub pay_url: Option<String>,
+    pub deeplink: Option<String>,
+    pub qr_code_url: Option<String>,
+}
+
+fn error_response(
+    code: i64,
+    message: Option<String>,
+    http_code: u16,
+    connector_transaction_id: Option<String>,
+) -> ErrorResponse {
+    ErrorResponse {
+        code: code.to_string(),
+        message: message
+            .clone()
+            .unwrap_or_else(|| "MoMo transaction failed".to_string()),
+        reason: message,
+        status_code: http_code,
+        attempt_status: Some(enums::AttemptStatus::Failure),
+        connector_transaction_id,
+        connector_response_reference_id: None,
+        network_advice_code: None,
+        network_decline_code: None,
+        network_error_message: None,
+        connector_metadata: None,
+    }
+}
+
+impl<F, T> TryFrom<ResponseRouterData<F, MomoPaymentsResponse, T, PaymentsResponseData>>
+    for RouterData<F, T, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, MomoPaymentsResponse, T, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let response = item.response;
+        if response.result_code != result_code::SUCCESS {
+            return Ok(Self {
+                status: enums::AttemptStatus::Failure,
+                response: Err(error_response(
+                    response.result_code,
+                    response.message,
+                    item.http_code,
+                    response.order_id,
+                )),
+                ..item.data
+            });
+        }
+        let pay_url = response
+            .pay_url
+            .ok_or(errors::ConnectorError::MissingRequiredField {
+                field_name: "payUrl".into(),
+            })?;
+        let redirection_url =
+            url::Url::parse(&pay_url).change_context(errors::ConnectorError::ParsingFailed)?;
+        let connector_metadata = response
+            .qr_code_url
+            .filter(|qr| !qr.is_empty())
+            .map(|qr| vn_utils::qr_code_metadata(qr, None, None))
+            .transpose()?;
+        let order_id = response
+            .order_id
+            .unwrap_or_else(|| item.data.connector_request_reference_id.clone());
+        Ok(Self {
+            status: enums::AttemptStatus::AuthenticationPending,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id: ResponseId::ConnectorTransactionId(order_id.clone()),
+                redirection_data: Box::new(Some(RedirectForm::from((
+                    redirection_url,
+                    common_utils::request::Method::Get,
+                )))),
+                mandate_reference: Box::new(None),
+                connector_metadata,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: Some(order_id),
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
