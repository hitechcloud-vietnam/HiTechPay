+// Errors & callbacks
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayErrorResponse {
+    pub return_code: Option<i64>,
+    pub return_message: Option<String>,
+    pub sub_return_code: Option<i64>,
+    pub sub_return_message: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayCallback {
+    pub data: String,
+    pub mac: String,
+    #[serde(rename = "type")]
+    pub callback_type: Option<i64>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ZalopayCallbackData {
+    pub app_id: Option<i64>,
+    pub app_trans_id: String,
+    pub app_time: Option<i64>,
+    pub app_user: Option<String>,
+    pub amount: Option<i64>,
+    pub embed_data: Option<String>,
+    pub zp_trans_id: Option<i64>,
+    pub server_time: Option<i64>,
+    pub channel: Option<i64>,
+}
+
+impl ZalopayCallbackData {
+    pub fn hitechpay_ref(&self) -> Option<String> {
+        self.embed_data
+            .as_ref()
+            .and_then(|embed| serde_json::from_str::<serde_json::Value>(embed).ok())
+            .and_then(|embed| {
+                embed
+                    .get("hitechpay_ref")
+                    .and_then(|value| value.as_str())
+                    .map(str::to_string)
+            })
+    }
+}
+
+impl From<&ZalopayCallbackData> for ZalopayQueryResponse {
+    fn from(data: &ZalopayCallbackData) -> Self {
+        // ZaloPay only sends callbacks for successful payments
+        Self {
+            return_code: return_code::SUCCESS,
+            return_message: Some("callback".to_string()),
+            sub_return_code: None,
+            sub_return_message: None,
+            is_processing: Some(false),
+            amount: data.amount,
+            zp_trans_id: data.zp_trans_id,
+        }
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn builds_app_trans_id() {
+        assert_eq!(
+            build_app_trans_id("261014", "pay_abc_1"),
+            "261014_pay_abc_1"
+        );
+        let long = "pay_".to_string() + &"x".repeat(60);
+        let id = build_app_trans_id("261014", &long);
+        assert!(id.len() <= MAX_APP_TRANS_ID_LEN);
+        assert!(id.starts_with("261014_HTP"));
+    }
+
+    #[test]
+    fn builds_m_refund_id() {
+        assert_eq!(
+            build_m_refund_id("261014", "2553", "ref_abc"),
+            "261014_2553_refabc"
+        );
+    }
+
+    #[test]
+    fn callback_mac_and_ref() {
+        let data = r#"{"app_id":2553,"app_trans_id":"261014_pay_1","app_time":1,"app_user":"u","amount":50000,"embed_data":"{\"redirecturl\":\"x\",\"preferred_payment_method\":[],\"hitechpay_ref\":\"pay_1\"}","item":"[]","zp_trans_id":240101000000001,"server_time":2,"channel":38}"#;
+        let parsed: ZalopayCallbackData = serde_json::from_str(data).unwrap();
+        assert_eq!(parsed.hitechpay_ref().as_deref(), Some("pay_1"));
+        let mac = vn_utils::hmac_sha256_hex("key2", data).unwrap();
+        assert!(vn_utils::secure_eq(
+            &mac,
+            &vn_utils::hmac_sha256_hex("key2", data).unwrap()
+        ));
+        let query = ZalopayQueryResponse::from(&parsed);
+        assert_eq!(attempt_status(&query), enums::AttemptStatus::Charged);
+    }
+
+    #[test]
+    fn maps_query_statuses() {
+        let mut response = ZalopayQueryResponse {
+            return_code: 3,
+            return_message: None,
+            sub_return_code: None,
+            sub_return_message: None,
+            is_processing: Some(false),
+            amount: None,
+            zp_trans_id: None,
+        };
+        assert_eq!(
+            attempt_status(&response),
+            enums::AttemptStatus::AuthenticationPending
+        );
+        response.is_processing = Some(true);
+        assert_eq!(attempt_status(&response), enums::AttemptStatus::Pending);
+        response.return_code = 2;
+        assert_eq!(attempt_status(&response), enums::AttemptStatus::Failure);
+    }
+}
