+/// IPN raw signature string
+pub fn ipn_signature_raw(access_key: &str, ipn: &MomoTransactionResponse) -> String {
+    format!(
+        "accessKey={access_key}&amount={}&extraData={}&message={}&orderId={}&orderInfo={}&orderType={}&partnerCode={}&payType={}&requestId={}&responseTime={}&resultCode={}&transId={}",
+        ipn.amount.unwrap_or_default(),
+        ipn.extra_data.clone().unwrap_or_default(),
+        ipn.message.clone().unwrap_or_default(),
+        ipn.order_id,
+        ipn.order_info.clone().unwrap_or_default(),
+        ipn.order_type.clone().unwrap_or_default(),
+        ipn.partner_code.clone().unwrap_or_default(),
+        ipn.pay_type.clone().unwrap_or_default(),
+        ipn.request_id.clone().unwrap_or_default(),
+        ipn.response_time.unwrap_or_default(),
+        ipn.result_code,
+        ipn.trans_id.unwrap_or_default(),
+    )
+}
+
+pub fn webhook_event(ipn: &MomoTransactionResponse) -> api_models::webhooks::IncomingWebhookEvent {
+    use api_models::webhooks::IncomingWebhookEvent;
+    match attempt_status_from_result_code(ipn.result_code) {
+        enums::AttemptStatus::Charged => IncomingWebhookEvent::PaymentIntentSuccess,
+        enums::AttemptStatus::Authorized => IncomingWebhookEvent::PaymentIntentAuthorizationSuccess,
+        enums::AttemptStatus::Pending | enums::AttemptStatus::AuthenticationPending => {
+            IncomingWebhookEvent::PaymentIntentProcessing
+        }
+        _ => IncomingWebhookEvent::PaymentIntentFailure,
+    }
+}
