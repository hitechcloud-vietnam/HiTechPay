+impl<F> TryFrom<&MomoRouterData<&RefundsRouterData<F>>> for MomoRefundRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(item: &MomoRouterData<&RefundsRouterData<F>>) -> Result<Self, Self::Error> {
+        let router_data = item.router_data;
+        let auth = MomoAuthType::try_from(&router_data.connector_auth_type)?;
+        let trans_id = router_data
+            .request
+            .connector_transaction_id
+            .parse::<i64>()
+            .change_context(errors::ConnectorError::MissingConnectorTransactionID)
+            .attach_printable("MoMo transId is not available yet, sync the payment first")?;
+        let order_id = router_data.request.refund_id.clone();
+        let request_id = order_id.clone();
+        let description = vn_utils::sanitize_memo(
+            router_data.request.reason.as_deref().unwrap_or("Hoan tien"),
+            200,
+        );
+        let raw = format!(
+            "accessKey={}&amount={}&description={description}&orderId={order_id}&partnerCode={}&requestId={request_id}&transId={trans_id}",
+            auth.access_key.peek(),
+            item.amount.get_amount_as_i64(),
+            auth.partner_code.peek()
+        );
+        Ok(Self {
+            partner_code: auth.partner_code.clone(),
+            order_id,
+            request_id,
+            amount: item.amount,
+            trans_id,
+            lang: "vi".to_string(),
+            description,
+            signature: auth.sign(&raw)?,
