+pub mod transformers;
+use std::sync::LazyLock;
+
+use common_enums::enums;
+use common_utils::{
+    crypto,
+    errors::CustomResult,
+    ext_traits::{BytesExt, ValueExt},
+    request::Request,
+    types::{AmountConvertor, MinorUnit, MinorUnitForConnector},
+};
+use error_stack::ResultExt;
+use hyperswitch_domain_models::{
+    router_data::{AccessToken, ConnectorAuthType, ErrorResponse, RouterData},
+    router_flow_types::{
+        access_token_auth::AccessTokenAuth,
+        payments::{Authorize, Capture, PSync, PaymentMethodToken, Session, SetupMandate, Void},
+        refunds::{Execute, RSync},
+    },
+    router_request_types::{
+        AccessTokenRequestData, PaymentMethodTokenizationData, PaymentsAuthorizeData,
+        PaymentsCancelData, PaymentsCaptureData, PaymentsSessionData, PaymentsSyncData,
+        RefundsData, SetupMandateRequestData,
+    },
+    router_response_types::{
+        ConnectorInfo, PaymentMethodDetails, PaymentsResponseData, RefundsResponseData,
+        SupportedPaymentMethods, SupportedPaymentMethodsExt,
+    },
+    types::{PaymentsAuthorizeRouterData, PaymentsSyncRouterData, RefundsRouterData},
+};
+use hyperswitch_interfaces::{
+    api::{
+        self, ConnectorCommon, ConnectorCommonExt, ConnectorIntegration, ConnectorSpecifications,
+        ConnectorValidation,
+    },
+    configs::Connectors,
+    errors,
+    events::connector_api_logs::ConnectorEvent,
+    types::Response,
+    webhooks,
+};
+use transformers as viettelmoney;
+
+use crate::{constants::headers, types::ResponseRouterData, utils};
+
+#[derive(Clone)]
+pub struct Viettelmoney {
+    amount_converter: &'static (dyn AmountConvertor<Output = MinorUnit> + Sync),
+}
+
+impl Viettelmoney {
+    pub fn new() -> &'static Self {
+        &Self {
+            amount_converter: &MinorUnitForConnector,
+        }
+    }
+}
+
+impl api::Payment for Viettelmoney {}
+impl api::PaymentSession for Viettelmoney {}
+impl api::ConnectorAccessToken for Viettelmoney {}
+impl api::MandateSetup for Viettelmoney {}
+impl api::PaymentAuthorize for Viettelmoney {}
+impl api::PaymentSync for Viettelmoney {}
+impl api::PaymentCapture for Viettelmoney {}
+impl api::PaymentVoid for Viettelmoney {}
+impl api::Refund for Viettelmoney {}
+impl api::RefundExecute for Viettelmoney {}
+impl api::RefundSync for Viettelmoney {}
+impl api::PaymentToken for Viettelmoney {}
+
+impl ConnectorIntegration<PaymentMethodToken, PaymentMethodTokenizationData, PaymentsResponseData>
+    for Viettelmoney
+{
+}
+
+impl<Flow, Request, Response> ConnectorCommonExt<Flow, Request, Response> for Viettelmoney
+where
+    Self: ConnectorIntegration<Flow, Request, Response>,
+{
+    fn build_headers(
+        &self,
+        _req: &RouterData<Flow, Request, Response>,
+        _connectors: &Connectors,
+    ) -> CustomResult<Vec<(String, hyperswitch_masking::Maskable<String>)>, errors::ConnectorError>
+    {
+        Ok(vec![(
+            headers::CONTENT_TYPE.to_string(),
+            self.get_content_type().to_string().into(),
+        )])
+    }
+}
+
+impl ConnectorCommon for Viettelmoney {
+    fn id(&self) -> &'static str {
+        "viettelmoney"
+    }
+
+    fn get_currency_unit(&self) -> api::CurrencyUnit {
+        api::CurrencyUnit::Minor
+    }
+
+    fn common_get_content_type(&self) -> &'static str {
+        "application/json"
+    }
+
+    fn base_url<'a>(&self, connectors: &'a Connectors) -> &'a str {
+        connectors.viettelmoney.base_url.as_ref()
+    }
+
+    fn get_auth_header(
+        &self,
+        _auth_type: &ConnectorAuthType,
+    ) -> CustomResult<Vec<(String, hyperswitch_masking::Maskable<String>)>, errors::ConnectorError>
+    {
+        // Viettel Money authenticates requests with a checksum inside the parameters
+        Ok(vec![])
+    }
+
+    fn build_error_response(
+        &self,
+        res: Response,
+        event_builder: Option<&mut ConnectorEvent>,
+    ) -> CustomResult<ErrorResponse, errors::ConnectorError> {
+        let response: viettelmoney::ViettelmoneyResult = res
+            .response
+            .parse_struct("ViettelmoneyResult")
+            .change_context(errors::ConnectorError::ResponseDeserializationFailed)?;
+
+        event_builder.map(|i| i.set_response_body(&response));
+        router_env::logger::info!(connector_response=?response);
+        let code = response
+            .error_code
+            .clone()
+            .unwrap_or_else(|| hyperswitch_interfaces::consts::NO_ERROR_CODE.to_string());
+
+        Ok(ErrorResponse {
+            status_code: res.status_code,
+            message: format!("Viettel Money error {code}"),
+            reason: None,
+            code,
+            attempt_status: None,
+            connector_transaction_id: None,
+            connector_response_reference_id: None,
+            network_advice_code: None,
+            network_decline_code: None,
+            network_error_message: None,
+            connector_metadata: None,
+        })
+    }
+}
+
+impl ConnectorValidation for Viettelmoney {}
+
+impl ConnectorIntegration<Session, PaymentsSessionData, PaymentsResponseData> for Viettelmoney {}
+
+impl ConnectorIntegration<AccessTokenAuth, AccessTokenRequestData, AccessToken> for Viettelmoney {}
+
+impl ConnectorIntegration<SetupMandate, SetupMandateRequestData, PaymentsResponseData>
+    for Viettelmoney
+{
+}
+
+/// Viettel Money: the merchant signs the payment page URL itself.
+/// The authorize flow therefore never sends a request (see
+/// `should_build_authorize_response_locally`) and `handle_response` builds the redirect.
+impl ConnectorIntegration<Authorize, PaymentsAuthorizeData, PaymentsResponseData> for Viettelmoney {
+    fn get_headers(
+        &self,
+        req: &PaymentsAuthorizeRouterData,
+        connectors: &Connectors,
+    ) -> CustomResult<Vec<(String, hyperswitch_masking::Maskable<String>)>, errors::ConnectorError>
+    {
+        self.build_headers(req, connectors)
+    }
+
+    fn get_content_type(&self) -> &'static str {
+        self.common_get_content_type()
+    }
+
+    fn build_request(
+        &self,
+        _req: &PaymentsAuthorizeRouterData,
+        _connectors: &Connectors,
+    ) -> CustomResult<Option<Request>, errors::ConnectorError> {
+        Ok(None)
+    }
+
+    fn handle_response(
+        &self,
+        data: &PaymentsAuthorizeRouterData,
+        _event_builder: Option<&mut ConnectorEvent>,
+        _res: Response,
+    ) -> CustomResult<PaymentsAuthorizeRouterData, errors::ConnectorError> {
+        let amount = utils::convert_amount(
+            self.amount_converter,
+            data.request.minor_amount,
+            data.request.currency,
+        )?;
+        let connector_router_data = viettelmoney::ViettelmoneyRouterData::from((amount, data));
+        let url = viettelmoney::build_payment_url(&connector_router_data)?;
+        Ok(viettelmoney::build_authorize_response(data, url))
+    }
+
+    fn get_error_response(
+        &self,
+        res: Response,
+        event_builder: Option<&mut ConnectorEvent>,
+    ) -> CustomResult<ErrorResponse, errors::ConnectorError> {
+        self.build_error_response(res, event_builder)
+    }
+}
+
+/// Status comes from the IPN or the signed return parameters: PSync never calls Viettel
+/// (see `should_build_psync_response_locally`).
+impl ConnectorIntegration<PSync, PaymentsSyncData, PaymentsResponseData> for Viettelmoney {
+    fn build_request(
+        &self,
+        _req: &PaymentsSyncRouterData,
+        _connectors: &Connectors,
+    ) -> CustomResult<Option<Request>, errors::ConnectorError> {
+        Ok(None)
+    }
+
+    fn handle_response(
+        &self,
+        data: &PaymentsSyncRouterData,
+        event_builder: Option<&mut ConnectorEvent>,
+        res: Response,
+    ) -> CustomResult<PaymentsSyncRouterData, errors::ConnectorError> {
+        let response: viettelmoney::ViettelmoneyResult = if res.response.is_empty() {
+            viettelmoney::ViettelmoneyResult::default()
+        } else {
+            res.response
+                .parse_struct("ViettelmoneyResult")
+                .change_context(errors::ConnectorError::ResponseDeserializationFailed)?
+        };
+        event_builder.map(|i| i.set_response_body(&response));
+        router_env::logger::info!(connector_response=?response);
+        RouterData::try_from(ResponseRouterData {
+            response,
+            data: data.clone(),
+            http_code: res.status_code,
+        })
+    }
+}
+
+impl ConnectorIntegration<Capture, PaymentsCaptureData, PaymentsResponseData> for Viettelmoney {}
+
+impl ConnectorIntegration<Void, PaymentsCancelData, PaymentsResponseData> for Viettelmoney {}
+
+/// Refunds are made from the Viettel Money merchant portal.
+impl ConnectorIntegration<Execute, RefundsData, RefundsResponseData> for Viettelmoney {
+    fn build_request(
+        &self,
+        _req: &RefundsRouterData<Execute>,
+        _connectors: &Connectors,
+    ) -> CustomResult<Option<Request>, errors::ConnectorError> {
+        Err(errors::ConnectorError::NotSupported {
+            message: "Refunds".to_string(),
+            connector: "viettelmoney",
+        }
+        .into())
+    }
+}
+
+impl ConnectorIntegration<RSync, RefundsData, RefundsResponseData> for Viettelmoney {}
+
+fn parse_result(
+    request: &webhooks::IncomingWebhookRequestDetails<'_>,
+) -> viettelmoney::ViettelmoneyResult {
+    let from_body = std::str::from_utf8(request.body)
+        .ok()
+        .map(|body| {
+            if body.trim_start().starts_with('{') {
+                serde_json::from_str(body).unwrap_or_default()
+            } else {
+                viettelmoney::ViettelmoneyResult::from_urlencoded(body)
+            }
+        })
+        .filter(|result: &viettelmoney::ViettelmoneyResult| !result.is_empty());
+    from_body
+        .unwrap_or_else(|| viettelmoney::ViettelmoneyResult::from_urlencoded(&request.query_params))
+}
+
+fn auth_from_account(
+    connector_account_details: crypto::Encryptable<hyperswitch_masking::Secret<serde_json::Value>>,
+) -> CustomResult<viettelmoney::ViettelmoneyAuthType, errors::ConnectorError> {
+    let auth_type: ConnectorAuthType = connector_account_details
+        .parse_value::<ConnectorAuthType>("ConnectorAuthType")
+        .change_context(errors::ConnectorError::WebhookSourceVerificationFailed)?;
+    viettelmoney::ViettelmoneyAuthType::try_from(&auth_type)
+}
+
+#[async_trait::async_trait]
+impl webhooks::IncomingWebhook for Viettelmoney {
+    async fn verify_webhook_source(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        _merchant_id: &common_utils::id_type::MerchantId,
+        _connector_webhook_details: Option<common_utils::pii::SecretSerdeValue>,
+        connector_account_details: crypto::Encryptable<
+            hyperswitch_masking::Secret<serde_json::Value>,
+        >,
+        _connector_label: &str,
+    ) -> CustomResult<bool, errors::ConnectorError> {
+        let auth = auth_from_account(connector_account_details)?;
+        Ok(parse_result(request).verify(&auth))
+    }
+
+    fn get_webhook_object_reference_id(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+    ) -> CustomResult<api_models::webhooks::ObjectReferenceId, errors::ConnectorError> {
+        let order_id = parse_result(request)
+            .order_id
+            .ok_or(errors::ConnectorError::WebhookReferenceIdNotFound)?;
+        Ok(api_models::webhooks::ObjectReferenceId::PaymentId(
+            api_models::payments::PaymentIdType::PaymentAttemptId(order_id),
+        ))
+    }
+
+    fn get_webhook_event_type(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        _context: Option<&webhooks::WebhookContext>,
+    ) -> CustomResult<api_models::webhooks::IncomingWebhookEvent, errors::ConnectorError> {
+        Ok(match parse_result(request).attempt_status() {
+            enums::AttemptStatus::Charged => {
+                api_models::webhooks::IncomingWebhookEvent::PaymentIntentSuccess
+            }
+            enums::AttemptStatus::Pending | enums::AttemptStatus::AuthenticationPending => {
+                api_models::webhooks::IncomingWebhookEvent::PaymentIntentProcessing
+            }
+            _ => api_models::webhooks::IncomingWebhookEvent::PaymentIntentFailure,
+        })
+    }
+
+    fn get_webhook_resource_object(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+    ) -> CustomResult<Box<dyn hyperswitch_masking::ErasedMaskSerialize>, errors::ConnectorError>
+    {
+        Ok(Box::new(parse_result(request)))
+    }
+
+    fn get_webhook_api_response(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        error_kind: Option<webhooks::IncomingWebhookFlowError>,
+        connector_authentication_type: Option<
+            crypto::Encryptable<hyperswitch_masking::Secret<serde_json::Value>>,
+        >,
+    ) -> CustomResult<
+        hyperswitch_domain_models::api::WebhookResponse<serde_json::Value>,
+        errors::ConnectorError,
+    > {
+        let error_code = match error_kind {
+            None => "00",
+            Some(webhooks::IncomingWebhookFlowError::ResourceNotFound) => "01",
+            Some(webhooks::IncomingWebhookFlowError::InternalError) => "99",
+        };
+        let Some(account) = connector_authentication_type else {
+            return Ok(hyperswitch_domain_models::api::WebhookResponse::Json(
+                serde_json::json!({"error_code": error_code}),
+            ));
+        };
+        let auth = auth_from_account(account)?;
+        let response =
+            viettelmoney::ViettelmoneyIpnResponse::new(&auth, &parse_result(request), error_code)?;
+        let body = serde_json::to_value(response)
+            .change_context(errors::ConnectorError::ResponseHandlingFailed)?;
+        Ok(hyperswitch_domain_models::api::WebhookResponse::Json(body))
+    }
+}
+
+static VIETTELMONEY_SUPPORTED_PAYMENT_METHODS: LazyLock<SupportedPaymentMethods> =
+    LazyLock::new(|| {
+        let supported_capture_methods = vec![
+            enums::CaptureMethod::Automatic,
+            enums::CaptureMethod::SequentialAutomatic,
+        ];
+
+        let mut viettelmoney_supported_payment_methods = SupportedPaymentMethods::new();
+
+        viettelmoney_supported_payment_methods.add(
+            enums::PaymentMethod::RealTimePayment,
+            enums::PaymentMethodType::VietQr,
+            PaymentMethodDetails {
+                mandates: enums::FeatureStatus::NotSupported,
+                refunds: enums::FeatureStatus::NotSupported,
+                supported_capture_methods: supported_capture_methods.clone(),
+                specific_features: None,
+            },
+        );
+
+        viettelmoney_supported_payment_methods.add(
+            enums::PaymentMethod::BankRedirect,
+            enums::PaymentMethodType::LocalBankRedirect,
+            PaymentMethodDetails {
+                mandates: enums::FeatureStatus::NotSupported,
+                refunds: enums::FeatureStatus::NotSupported,
+                supported_capture_methods,
+                specific_features: None,
+            },
+        );
+
+        viettelmoney_supported_payment_methods
+    });
+
+static VIETTELMONEY_CONNECTOR_INFO: ConnectorInfo = ConnectorInfo {
+    display_name: "Viettel Money",
+    description: "Viettel Money (ViettelPay): payments from Viettel Money wallets, linked bank accounts and VietQR through the Viettel payment gateway.",
+    connector_type: enums::HyperswitchConnectorCategory::AlternativePaymentMethod,
+    integration_status: enums::ConnectorIntegrationStatus::Sandbox,
+};
+
+static VIETTELMONEY_SUPPORTED_WEBHOOK_FLOWS: [enums::EventClass; 1] = [enums::EventClass::Payments];
+
+impl ConnectorSpecifications for Viettelmoney {
+    fn get_connector_about(&self) -> Option<&'static ConnectorInfo> {
+        Some(&VIETTELMONEY_CONNECTOR_INFO)
+    }
+
+    fn get_supported_payment_methods(&self) -> Option<&'static SupportedPaymentMethods> {
+        Some(&*VIETTELMONEY_SUPPORTED_PAYMENT_METHODS)
+    }
+
+    fn get_supported_webhook_flows(&self) -> Option<&'static [enums::EventClass]> {
+        Some(&VIETTELMONEY_SUPPORTED_WEBHOOK_FLOWS)
+    }
+
+    fn should_build_authorize_response_locally(&self) -> bool {
+        true
+    }
+
+    fn should_build_psync_response_locally(&self) -> bool {
+        true
+    }
+}
diff --git a/crates/hyperswitch_connectors/src/connectors/viettelmoney/transformers.rs b/crates/hyperswitch_connectors/src/connectors/viettelmoney/transformers.rs
