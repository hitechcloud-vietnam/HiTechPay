+//! VNPAY payment gateway (API v2.1.0) transformers.
+//!
+//! * Pay      : redirect to `vpcpay.html?<params>&vnp_SecureHash=<HMAC-SHA512>` (built locally)
+//! * Query    : `POST merchant_webapi/api/transaction` with `vnp_Command=querydr`
+//! * Refund   : `POST merchant_webapi/api/transaction` with `vnp_Command=refund`
+//! * IPN      : `GET <ipn url>?vnp_...&vnp_SecureHash=...` → respond `{"RspCode":"00","Message":"Confirm Success"}`
+
+// VNPAY field names are mixed case (`vnp_TxnRef`), keep them verbatim.
+#![allow(non_snake_case)]
+
+use std::collections::BTreeMap;
