+//! payOS transformers (VietQR payment links).
+//!
+//! API reference: <https://payos.vn/docs/api/>
+//! * create : `POST /v2/payment-requests`               signature over `amount&cancelUrl&description&orderCode&returnUrl`
+//! * get    : `GET  /v2/payment-requests/{orderCode}`
+//! * cancel : `POST /v2/payment-requests/{orderCode}/cancel`
+//! * webhook: `{code, desc, success, data, signature}`, signature = HMAC_SHA256(checksumKey, sorted `data` as query string)
+
+use std::collections::BTreeMap;
+
+use common_enums::enums;
+use common_utils::types::MinorUnit;
+use error_stack::ResultExt;
+use hyperswitch_domain_models::{
+    payment_method_data::{PaymentMethodData, RealTimePaymentData},
+    router_data::{ConnectorAuthType, ErrorResponse, RouterData},
+    router_request_types::ResponseId,
+    router_response_types::{PaymentsResponseData, RedirectForm},
+    types::{PaymentsAuthorizeRouterData, PaymentsCancelRouterData},
+};
+use hyperswitch_interfaces::errors;
+use hyperswitch_masking::{PeekInterface, Secret};
+use serde::{Deserialize, Serialize};
+use sha2::Digest;
+
+use crate::{
+    types::ResponseRouterData,
+    utils::{PaymentsAuthorizeRequestData, RouterData as _},
+    vn_utils,
+};
+
+/// payOS limits the transfer description to 25 characters
+const MAX_DESCRIPTION_LEN: usize = 25;
+const PAYMENT_EXPIRY_MINUTES: i64 = 15;
+
+pub struct PayosRouterData<T> {
+    pub amount: MinorUnit,
+    pub router_data: T,
+}
+
+impl<T> From<(MinorUnit, T)> for PayosRouterData<T> {
+    fn from((amount, item): (MinorUnit, T)) -> Self {
+        Self {
+            amount,
+            router_data: item,
+        }
+    }
+}
+
+pub struct PayosAuthType {
+    pub client_id: Secret<String>,
+    pub api_key: Secret<String>,
+    pub checksum_key: Secret<String>,
+}
+
+impl TryFrom<&ConnectorAuthType> for PayosAuthType {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(auth_type: &ConnectorAuthType) -> Result<Self, Self::Error> {
+        match auth_type {
+            ConnectorAuthType::SignatureKey {
+                api_key,
+                key1,
+                api_secret,
+            } => Ok(Self {
+                client_id: api_key.to_owned(),
+                api_key: key1.to_owned(),
+                checksum_key: api_secret.to_owned(),
+            }),
+            _ => Err(errors::ConnectorError::FailedToObtainAuthType.into()),
+        }
+    }
+}
+
+impl PayosAuthType {
+    pub fn sign(&self, data: &str) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+        vn_utils::hmac_sha256_hex(self.checksum_key.peek(), data)
+    }
+}
+
+/// payOS `orderCode` must be a positive integer (≤ 2^53 - 1). It is derived
+/// deterministically from the HiTechPay attempt reference (48 bits of SHA-256).
+pub fn order_code(reference: &str) -> i64 {
+    let digest = sha2::Sha256::digest(reference.as_bytes());
+    let mut bytes = [0u8; 8];
+    bytes[2..].copy_from_slice(&digest[..6]);
+    let value = i64::from_be_bytes(bytes);
+    if value == 0 {
+        1
+    } else {
+        value
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PayosPaymentsRequest {
+    pub order_code: i64,
+    pub amount: i64,
+    pub description: String,
+    pub return_url: String,
+    pub cancel_url: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub buyer_name: Option<Secret<String>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub buyer_email: Option<common_utils::pii::Email>,
+    pub expired_at: i64,
+    pub signature: String,
+}
+
+pub fn create_signature_data(
+    amount: i64,
+    cancel_url: &str,
+    description: &str,
+    order_code: i64,
+    return_url: &str,
+) -> String {
+    format!(
+        "amount={amount}&cancelUrl={cancel_url}&description={description}&orderCode={order_code}&returnUrl={return_url}"
+    )
+}
+
+impl TryFrom<&PayosRouterData<&PaymentsAuthorizeRouterData>> for PayosPaymentsRequest {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(item: &PayosRouterData<&PaymentsAuthorizeRouterData>) -> Result<Self, Self::Error> {
+        let router_data = item.router_data;
+        if router_data.request.currency != enums::Currency::VND {
+            Err(errors::ConnectorError::NotSupported {
+                message: format!("currency {}", router_data.request.currency),
+                connector: "payos",
+            })?
+        }
+        match &router_data.request.payment_method_data {
+            PaymentMethodData::RealTimePayment(rtp)
+                if matches!(rtp.as_ref(), RealTimePaymentData::VietQr {}) => {}
+            _ => Err(errors::ConnectorError::NotImplemented(
+                crate::utils::get_unimplemented_payment_method_error_message("payos"),
+            ))?,
+        }
+        let auth = PayosAuthType::try_from(&router_data.connector_auth_type)?;
+        let reference = router_data.connector_request_reference_id.clone();
+        let order_code = order_code(&reference);
+        let amount = item.amount.get_amount_as_i64();
+        let description =
+            vn_utils::sanitize_memo(&vn_utils::transfer_code(&reference), MAX_DESCRIPTION_LEN);
+        let return_url = router_data.request.get_router_return_url()?;
+        let cancel_url = return_url.clone();
+        let expired_at = (time::OffsetDateTime::now_utc()
+            + time::Duration::minutes(PAYMENT_EXPIRY_MINUTES))
+        .unix_timestamp();
+        let signature = auth.sign(&create_signature_data(
+            amount,
+            &cancel_url,
+            &description,
+            order_code,
+            &return_url,
+        ))?;
+        Ok(Self {
+            order_code,
+            amount,
+            description,
+            return_url,
+            cancel_url,
+            buyer_name: router_data.get_optional_billing_full_name(),
+            buyer_email: router_data.request.email.clone(),
+            expired_at,
+            signature,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PayosPaymentLinkData {
+    pub bin: Option<String>,
+    pub account_number: Option<String>,
+    pub account_name: Option<String>,
+    pub amount: Option<i64>,
+    pub description: Option<String>,
+    pub order_code: i64,
+    pub currency: Option<String>,
+    pub payment_link_id: Option<String>,
+    pub status: Option<PayosStatus>,
+    pub checkout_url: Option<String>,
+    pub qr_code: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PayosResponse<T> {
+    pub code: String,
+    pub desc: Option<String>,
+    pub data: Option<T>,
+    pub signature: Option<String>,
+}
+
+fn error_response(code: String, desc: Option<String>, http_code: u16) -> ErrorResponse {
+    ErrorResponse {
+        code,
+        message: desc
+            .clone()
+            .unwrap_or_else(|| "payOS request failed".to_string()),
+        reason: desc,
+        status_code: http_code,
+        attempt_status: None,
+        connector_transaction_id: None,
+        connector_response_reference_id: None,
+        network_advice_code: None,
+        network_decline_code: None,
+        network_error_message: None,
+        connector_metadata: None,
+    }
+}
+
+impl<F, T>
+    TryFrom<ResponseRouterData<F, PayosResponse<PayosPaymentLinkData>, T, PaymentsResponseData>>
+    for RouterData<F, T, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, PayosResponse<PayosPaymentLinkData>, T, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let response = item.response;
+        let data = match (response.code.as_str(), response.data) {
+            ("00", Some(data)) => data,
+            (_, _) => {
+                return Ok(Self {
+                    status: enums::AttemptStatus::Failure,
+                    response: Err(ErrorResponse {
+                        attempt_status: Some(enums::AttemptStatus::Failure),
+                        ..error_response(response.code, response.desc, item.http_code)
+                    }),
+                    ..item.data
+                })
+            }
+        };
+        let redirection_data = data
+            .checkout_url
+            .as_ref()
+            .map(|checkout_url| {
+                url::Url::parse(checkout_url)
+                    .change_context(errors::ConnectorError::ParsingFailed)
+                    .map(|url| RedirectForm::from((url, common_utils::request::Method::Get)))
+            })
+            .transpose()?;
+        let connector_metadata = data
+            .qr_code
+            .clone()
+            .filter(|qr| !qr.is_empty())
+            .map(|qr| vn_utils::qr_code_metadata(qr, None, None))
+            .transpose()?;
+        let order_code = data.order_code.to_string();
+        Ok(Self {
+            status: enums::AttemptStatus::AuthenticationPending,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id: ResponseId::ConnectorTransactionId(order_code.clone()),
+                redirection_data: Box::new(redirection_data),
+                mandate_reference: Box::new(None),
+                connector_metadata,
+                network_txn_id: None,
+                network_txn_link_id: data.payment_link_id,
+                connector_response_reference_id: Some(order_code),
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+// ---------------------------------------------------------------------------
+// PSync / Cancel
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "UPPERCASE")]
+pub enum PayosStatus {
+    Pending,
+    Processing,
+    Paid,
+    Underpaid,
+    Cancelled,
+    Expired,
+    Failed,
+}
+
+impl From<PayosStatus> for enums::AttemptStatus {
+    fn from(status: PayosStatus) -> Self {
+        match status {
+            PayosStatus::Paid => Self::Charged,
+            PayosStatus::Underpaid => Self::PartialCharged,
+            PayosStatus::Pending => Self::AuthenticationPending,
+            PayosStatus::Processing => Self::Pending,
+            PayosStatus::Cancelled => Self::Voided,
+            PayosStatus::Expired => Self::AuthenticationFailed,
+            PayosStatus::Failed => Self::Failure,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PayosPaymentInfo {
+    pub id: Option<String>,
+    pub order_code: i64,
+    pub amount: Option<i64>,
+    pub amount_paid: Option<i64>,
+    pub amount_remaining: Option<i64>,
+    pub status: PayosStatus,
+    pub cancellation_reason: Option<String>,
+}
+
+impl<F, T> TryFrom<ResponseRouterData<F, PayosResponse<PayosPaymentInfo>, T, PaymentsResponseData>>
+    for RouterData<F, T, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, PayosResponse<PayosPaymentInfo>, T, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let response = item.response;
+        let info = match (response.code.as_str(), response.data) {
+            ("00", Some(info)) => info,
+            (_, _) => {
+                return Ok(Self {
+                    response: Err(error_response(response.code, response.desc, item.http_code)),
+                    ..item.data
+                })
+            }
+        };
+        let status = enums::AttemptStatus::from(info.status);
+        if matches!(
+            status,
+            enums::AttemptStatus::Failure | enums::AttemptStatus::AuthenticationFailed
+        ) {
+            return Ok(Self {
+                status,
+                response: Err(ErrorResponse {
+                    attempt_status: Some(status),
+                    ..error_response(
+                        format!("{:?}", info.status).to_uppercase(),
+                        info.cancellation_reason.clone(),
+                        item.http_code,
+                    )
+                }),
+                ..item.data
+            });
+        }
+        let order_code = info.order_code.to_string();
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id: ResponseId::ConnectorTransactionId(order_code.clone()),
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: info.id,
+                connector_response_reference_id: Some(order_code),
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PayosCancelRequest {
+    pub cancellation_reason: String,
+}
+
+impl From<&PaymentsCancelRouterData> for PayosCancelRequest {
+    fn from(item: &PaymentsCancelRouterData) -> Self {
+        Self {
+            cancellation_reason: vn_utils::sanitize_memo(
+                item.request
+                    .cancellation_reason
+                    .as_deref()
+                    .unwrap_or("Merchant cancelled"),
+                100,
+            ),
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Webhooks
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PayosWebhook {
+    pub code: String,
+    pub desc: Option<String>,
+    pub success: Option<bool>,
+    pub data: serde_json::Map<String, serde_json::Value>,
+    pub signature: String,
+}
+
+impl PayosWebhook {
+    pub fn order_code(&self) -> Option<i64> {
+        self.data.get("orderCode").and_then(|v| v.as_i64())
+    }
+
+    pub fn is_paid(&self) -> bool {
+        self.code == "00"
+            && self
+                .data
+                .get("code")
+                .and_then(|v| v.as_str())
+                .unwrap_or("00")
+                == "00"
+    }
+
+    /// Payment info passed to PSync when the webhook is processed
+    pub fn to_payment_info(&self) -> Option<PayosResponse<PayosPaymentInfo>> {
+        let order_code = self.order_code()?;
+        let amount = self.data.get("amount").and_then(|v| v.as_i64());
+        Some(PayosResponse {
+            code: "00".to_string(),
+            desc: self.desc.clone(),
+            data: Some(PayosPaymentInfo {
+                id: self
+                    .data
+                    .get("paymentLinkId")
+                    .and_then(|v| v.as_str())
+                    .map(str::to_string),
+                order_code,
+                amount,
+                amount_paid: amount,
+                amount_remaining: Some(0),
+                status: if self.is_paid() {
+                    PayosStatus::Paid
+                } else {
+                    PayosStatus::Failed
+                },
+                cancellation_reason: None,
+            }),
+            signature: None,
+        })
+    }
+}
+
+/// payOS webhook / response data signature: keys sorted, `key=value` joined with `&`,
+/// `null` rendered as an empty string, nested values as JSON.
+pub fn data_signature_payload(data: &serde_json::Map<String, serde_json::Value>) -> String {
+    let sorted: BTreeMap<&String, &serde_json::Value> = data.iter().collect();
+    sorted
+        .into_iter()
+        .map(|(key, value)| {
+            let value = match value {
+                serde_json::Value::Null => String::new(),
+                serde_json::Value::String(text) if text == "null" || text == "undefined" => {
+                    String::new()
+                }
+                serde_json::Value::String(text) => text.clone(),
+                other => other.to_string(),
+            };
+            format!("{key}={value}")
+        })
+        .collect::<Vec<_>>()
+        .join("&")
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn order_code_is_safe_integer() {
+        let code = order_code("pay_abc_1");
+        assert!(code > 0);
+        assert!(code < 9_007_199_254_740_991);
+        assert_eq!(code, order_code("pay_abc_1"));
+        assert_ne!(code, order_code("pay_abc_2"));
+    }
+
+    #[test]
+    fn create_signature_payload() {
+        assert_eq!(
+            create_signature_data(2000, "https://c", "HTP0123", 123, "https://r"),
+            "amount=2000&cancelUrl=https://c&description=HTP0123&orderCode=123&returnUrl=https://r"
+        );
+    }
+
+    #[test]
+    fn webhook_signature_and_mapping() {
+        let body = r#"{"code":"00","desc":"success","success":true,"data":{"orderCode":123,"amount":3000,"description":"VQRIO123","accountNumber":"12345678","reference":"TF230204212323","transactionDateTime":"2023-02-04 18:25:00","currency":"VND","paymentLinkId":"124c33293c43417ab7879e14c8d9eb18","code":"00","desc":"Thành công","counterAccountBankId":"","counterAccountBankName":"","counterAccountName":"","counterAccountNumber":"","virtualAccountName":"","virtualAccountNumber":""},"signature":"x"}"#;
+        let webhook: PayosWebhook = serde_json::from_str(body).unwrap();
+        let payload = data_signature_payload(&webhook.data);
+        assert!(payload.starts_with("accountNumber=12345678&amount=3000&code=00"));
+        assert!(payload.contains("&orderCode=123&"));
+        let info = webhook.to_payment_info().unwrap().data.unwrap();
+        assert_eq!(info.status, PayosStatus::Paid);
+        assert_eq!(
+            enums::AttemptStatus::from(info.status),
+            enums::AttemptStatus::Charged
+        );
+    }
+}
