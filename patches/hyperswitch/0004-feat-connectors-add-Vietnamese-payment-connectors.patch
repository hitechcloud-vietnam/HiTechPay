+
+pub fn attempt_status_from_result_code(code: i64) -> enums::AttemptStatus {
+    match code {
+        result_code::SUCCESS => enums::AttemptStatus::Charged,
+        result_code::AUTHORIZED => enums::AttemptStatus::Authorized,
+        result_code::INITIATED | result_code::PENDING_USER => {
+            enums::AttemptStatus::AuthenticationPending
+        }
+        result_code::PENDING_CONFIRM | result_code::PROCESSING => enums::AttemptStatus::Pending,
+        result_code::USER_CANCELLED => enums::AttemptStatus::AuthenticationFailed,
+        _ => enums::AttemptStatus::Failure,
+    }
+}
+
+impl<F, T> TryFrom<ResponseRouterData<F, MomoTransactionResponse, T, PaymentsResponseData>>
+    for RouterData<F, T, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, MomoTransactionResponse, T, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let response = item.response;
+        let status = attempt_status_from_result_code(response.result_code);
+        let resource_id = response
+            .trans_id
+            .filter(|id| *id > 0)
+            .map(|id| ResponseId::ConnectorTransactionId(id.to_string()))
+            .unwrap_or_else(|| ResponseId::ConnectorTransactionId(response.order_id.clone()));
+        if matches!(
+            status,
+            enums::AttemptStatus::Failure | enums::AttemptStatus::AuthenticationFailed
+        ) {
+            return Ok(Self {
+                status,
+                response: Err(ErrorResponse {
+                    attempt_status: Some(status),
+                    ..error_response(
+                        response.result_code,
+                        response.message,
+                        item.http_code,
+                        response.trans_id.map(|id| id.to_string()),
+                    )
+                }),
+                ..item.data
+            });
+        }
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id,
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: Some(response.order_id),
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
