+/// Metadata kept on the payment attempt; VNPAY requires the original create date
+/// (`vnp_TransactionDate`) for query and refund calls.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct VnpayConnectorMetadata {
+    pub vnp_create_date: String,
+}
+
+fn get_locale(language: Option<&String>) -> &'static str {
+    match language.map(|l| l.to_ascii_lowercase()) {
+        Some(lang) if lang.starts_with("en") => "en",
+        _ => "vn",
+    }
+}
