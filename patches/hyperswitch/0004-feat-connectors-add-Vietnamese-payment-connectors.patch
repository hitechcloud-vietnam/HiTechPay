+                .change_context(errors::ConnectorError::ResponseDeserializationFailed)?
+        };
+        event_builder.map(|i| i.set_response_body(&response));
+        router_env::logger::info!(connector_response=?response);
+        RouterData::try_from(ResponseRouterData {
+            response,
+            data: data.clone(),
+            http_code: res.status_code,
+        })
+    }
+}
+
+impl ConnectorIntegration<Capture, PaymentsCaptureData, PaymentsResponseData> for Pay2s {}
+
+impl ConnectorIntegration<Void, PaymentsCancelData, PaymentsResponseData> for Pay2s {}
+
+/// Bank transfers cannot be refunded through the API: the merchant transfers the money back.
+impl ConnectorIntegration<Execute, RefundsData, RefundsResponseData> for Pay2s {
+    fn build_request(
+        &self,
+        _req: &RefundsRouterData<Execute>,
+        _connectors: &Connectors,
+    ) -> CustomResult<Option<Request>, errors::ConnectorError> {
+        Err(errors::ConnectorError::NotSupported {
+            message: "Refunds".to_string(),
+            connector: "pay2s",
+        }
+        .into())
+    }
+}
+
+impl ConnectorIntegration<RSync, RefundsData, RefundsResponseData> for Pay2s {}
+
+fn parse_webhook(
+    request: &webhooks::IncomingWebhookRequestDetails<'_>,
+) -> CustomResult<pay2s::Pay2sWebhook, errors::ConnectorError> {
+    request
+        .body
+        .parse_struct::<pay2s::Pay2sWebhook>("Pay2sWebhook")
+        .change_context(errors::ConnectorError::WebhookBodyDecodingFailed)
+}
+
+#[async_trait::async_trait]
+impl webhooks::IncomingWebhook for Pay2s {
+    async fn verify_webhook_source(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        merchant_id: &common_utils::id_type::MerchantId,
+        connector_webhook_details: Option<common_utils::pii::SecretSerdeValue>,
+        _connector_account_details: crypto::Encryptable<
+            hyperswitch_masking::Secret<serde_json::Value>,
+        >,
+        connector_label: &str,
+    ) -> CustomResult<bool, errors::ConnectorError> {
+        let secrets = self
+            .get_webhook_source_verification_merchant_secret(
+                merchant_id,
+                connector_label,
+                connector_webhook_details,
+            )
+            .await?;
+        let secret = String::from_utf8(secrets.secret)
+            .change_context(errors::ConnectorError::WebhookVerificationSecretInvalid)?;
+        if secret.is_empty() || secret == "default_secret" {
+            return Ok(false);
+        }
+        let authorization = utils::get_header_key_value("authorization", request.headers)
+            .change_context(errors::ConnectorError::WebhookSignatureNotFound)?;
+        let token = authorization
+            .trim()
+            .strip_prefix("Bearer ")
+            .or_else(|| authorization.trim().strip_prefix("Apikey "))
+            .unwrap_or(authorization.trim());
+        Ok(vn_utils::secure_eq(token.trim(), secret.as_str()))
+    }
+
+    fn get_webhook_object_reference_id(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+    ) -> CustomResult<api_models::webhooks::ObjectReferenceId, errors::ConnectorError> {
+        let webhook = parse_webhook(request)?;
+        let code = webhook
+            .transfer_code()
+            .ok_or(errors::ConnectorError::WebhookReferenceIdNotFound)?;
+        Ok(api_models::webhooks::ObjectReferenceId::PaymentId(
+            api_models::payments::PaymentIdType::ConnectorTransactionId(code),
+        ))
+    }
+
+    fn get_webhook_event_type(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        _context: Option<&webhooks::WebhookContext>,
+    ) -> CustomResult<api_models::webhooks::IncomingWebhookEvent, errors::ConnectorError> {
+        let webhook = parse_webhook(request)?;
+        Ok(
+            if webhook.is_incoming() && webhook.transfer_code().is_some() {
+                api_models::webhooks::IncomingWebhookEvent::PaymentIntentSuccess
+            } else {
+                api_models::webhooks::IncomingWebhookEvent::EventNotSupported
+            },
+        )
+    }
+
+    fn get_webhook_resource_object(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+    ) -> CustomResult<Box<dyn hyperswitch_masking::ErasedMaskSerialize>, errors::ConnectorError>
+    {
+        let webhook = parse_webhook(request)?;
+        Ok(Box::new(pay2s::Pay2sTransactionsResponse::from(&webhook)))
+    }
+
+    fn get_webhook_api_response(
+        &self,
+        _request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        _error_kind: Option<webhooks::IncomingWebhookFlowError>,
+        _connector_authentication_type: Option<
+            crypto::Encryptable<hyperswitch_masking::Secret<serde_json::Value>>,
+        >,
+    ) -> CustomResult<
+        hyperswitch_domain_models::api::WebhookResponse<serde_json::Value>,
+        errors::ConnectorError,
+    > {
+        Ok(hyperswitch_domain_models::api::WebhookResponse::Json(
+            serde_json::json!({"success": true}),
+        ))
+    }
+}
+
+static PAY2S_SUPPORTED_PAYMENT_METHODS: LazyLock<SupportedPaymentMethods> = LazyLock::new(|| {
+    let supported_capture_methods = vec![
+        enums::CaptureMethod::Automatic,
+        enums::CaptureMethod::SequentialAutomatic,
+    ];
+
+    let mut pay2s_supported_payment_methods = SupportedPaymentMethods::new();
+
+    pay2s_supported_payment_methods.add(
+        enums::PaymentMethod::RealTimePayment,
+        enums::PaymentMethodType::VietQr,
+        PaymentMethodDetails {
+            mandates: enums::FeatureStatus::NotSupported,
+            refunds: enums::FeatureStatus::NotSupported,
+            supported_capture_methods: supported_capture_methods.clone(),
+            specific_features: None,
+        },
+    );
+
+    pay2s_supported_payment_methods
+});
+
+static PAY2S_CONNECTOR_INFO: ConnectorInfo = ConnectorInfo {
+    display_name: "Pay2S",
+    description: "Pay2S: VietQR bank transfer collection into the merchant bank account with automatic Pay2S transaction notifications.",
+    connector_type: enums::HyperswitchConnectorCategory::PaymentGateway,
+    integration_status: enums::ConnectorIntegrationStatus::Sandbox,
+};
+
+static PAY2S_SUPPORTED_WEBHOOK_FLOWS: [enums::EventClass; 1] = [enums::EventClass::Payments];
+
+impl ConnectorSpecifications for Pay2s {
+    fn get_connector_about(&self) -> Option<&'static ConnectorInfo> {
+        Some(&PAY2S_CONNECTOR_INFO)
+    }
+
+    fn get_supported_payment_methods(&self) -> Option<&'static SupportedPaymentMethods> {
+        Some(&*PAY2S_SUPPORTED_PAYMENT_METHODS)
+    }
+
+    fn get_supported_webhook_flows(&self) -> Option<&'static [enums::EventClass]> {
+        Some(&PAY2S_SUPPORTED_WEBHOOK_FLOWS)
+    }
+
+    fn should_build_authorize_response_locally(&self) -> bool {
+        true
+    }
+
+    fn should_build_psync_response_locally(&self) -> bool {
+        true
+    }
+}
diff --git a/crates/hyperswitch_connectors/src/connectors/pay2s/transformers.rs b/crates/hyperswitch_connectors/src/connectors/pay2s/transformers.rs
