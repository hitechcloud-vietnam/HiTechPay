--- /dev/null
+++ b/crates/hyperswitch_connectors/src/connectors/pay2s/transformers.rs
@@ -0,0 +1,312 @@
+//! Pay2S transformers (bank transfer collection via VietQR).
+//!
+//! Flow
+//! 1. Authorize: a dynamic VietQR is rendered locally for the merchant bank account with a
+//!    HiTechPay transfer code (e.g. `HTP4F1C0A9B22D7`) as the transfer memo. No API call.
+//! 2. Pay2S detects the incoming transfer and calls the webhook with header
+//!    `Authorization: Bearer <webhook token>`. Both the batched shape
+//!    `{"transactions":[{...}]}` and a single transaction object are accepted; field names
+//!    are matched case-insensitively in camelCase or snake_case.
+//! 3. PSync is resolved locally (no status query API is used): the status comes from the
+//!    webhook.
+//!
+//! NOTE: field names follow the Pay2S "Open Banking API" webhook. Verify against the
+//! merchant's Pay2S dashboard before going live.
+
+use common_enums::enums;
+use hyperswitch_domain_models::{
+    router_data::{ConnectorAuthType, ErrorResponse, RouterData},
+    router_request_types::{PaymentsSyncData, ResponseId},
+    router_response_types::PaymentsResponseData,
+};
+use hyperswitch_interfaces::errors;
+use hyperswitch_masking::{PeekInterface, Secret};
+use serde::{Deserialize, Serialize};
+
+use crate::{types::ResponseRouterData, vn_utils};
+
+pub const VIETQR_IMAGE_URL: &str = "https://img.vietqr.io/image";
+
+pub struct Pay2sAuthType {
+    pub api_token: Secret<String>,
+    pub account_number: Secret<String>,
+    pub bank: Secret<String>,
+}
+
+impl TryFrom<&ConnectorAuthType> for Pay2sAuthType {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(auth_type: &ConnectorAuthType) -> Result<Self, Self::Error> {
+        match auth_type {
+            ConnectorAuthType::SignatureKey {
+                api_key,
+                key1,
+                api_secret,
+            } => Ok(Self {
+                api_token: api_key.to_owned(),
+                account_number: key1.to_owned(),
+                bank: api_secret.to_owned(),
+            }),
+            _ => Err(errors::ConnectorError::FailedToObtainAuthType.into()),
+        }
+    }
+}
+
+/// `https://img.vietqr.io/image/<bin>-<account>-compact2.png?amount=..&addInfo=..`
+pub fn qr_image_url(auth: &Pay2sAuthType, amount: i64, memo: &str) -> Option<url::Url> {
+    let bin = vn_utils::resolve_bank_bin(auth.bank.peek())?;
+    url::Url::parse_with_params(
+        &format!(
+            "{VIETQR_IMAGE_URL}/{bin}-{}-compact2.png",
+            auth.account_number.peek()
+        ),
+        &[
+            ("amount", amount.to_string()),
+            ("addInfo", memo.to_string()),
+        ],
+    )
+    .ok()
+}
+
+/// A single bank transaction notified by Pay2S
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+pub struct Pay2sTransaction {
+    #[serde(default, alias = "transaction_id", alias = "transactionId")]
+    pub id: Option<serde_json::Value>,
+    #[serde(default)]
+    pub gateway: Option<String>,
+    #[serde(default, alias = "transactionDate", alias = "transaction_date")]
+    pub transaction_date: Option<String>,
+    #[serde(
+        default,
+        alias = "transactionNumber",
+        alias = "transaction_number",
+        alias = "referenceCode",
+        alias = "reference_code"
+    )]
+    pub transaction_number: Option<String>,
+    #[serde(default, alias = "accountNumber", alias = "account_number")]
+    pub account_number: Option<String>,
+    #[serde(default, alias = "description", alias = "transaction_content")]
+    pub content: Option<String>,
+    #[serde(
+        default,
+        alias = "transferType",
+        alias = "transfer_type",
+        alias = "type"
+    )]
+    pub transfer_type: Option<String>,
+    #[serde(
+        default,
+        alias = "transferAmount",
+        alias = "transfer_amount",
+        alias = "amount"
+    )]
+    pub transfer_amount: Option<serde_json::Value>,
+}
+
+impl Pay2sTransaction {
+    pub fn is_incoming(&self) -> bool {
+        self.transfer_type
+            .as_deref()
+            .map(|kind| kind.eq_ignore_ascii_case("in") || kind.eq_ignore_ascii_case("credit"))
+            .unwrap_or(true)
+    }
+
+    pub fn transfer_code(&self) -> Option<String> {
+        self.content
+            .as_deref()
+            .and_then(vn_utils::extract_transfer_code)
+    }
+
+    pub fn incoming_amount(&self) -> i64 {
+        if !self.is_incoming() {
+            return 0;
+        }
+        self.transfer_amount
+            .as_ref()
+            .and_then(vn_utils::parse_vnd_amount)
+            .unwrap_or_default()
+    }
+}
+
+/// Webhook body: batched or single transaction
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum Pay2sWebhook {
+    Batch { transactions: Vec<Pay2sTransaction> },
+    Single(Pay2sTransaction),
+}
+
+impl Pay2sWebhook {
+    pub fn transactions(&self) -> Vec<Pay2sTransaction> {
+        match self {
+            Self::Batch { transactions } => transactions.clone(),
+            Self::Single(transaction) => vec![transaction.clone()],
+        }
+    }
+
+    pub fn is_incoming(&self) -> bool {
+        self.transactions()
+            .iter()
+            .any(Pay2sTransaction::is_incoming)
+    }
+
+    /// The first HiTechPay transfer code found in the batch
+    pub fn transfer_code(&self) -> Option<String> {
+        self.transactions()
+            .iter()
+            .filter(|txn| txn.is_incoming())
+            .find_map(Pay2sTransaction::transfer_code)
+    }
+}
+
+/// Resource object handed to PSync when a webhook is processed
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+pub struct Pay2sTransactionsResponse {
+    #[serde(default)]
+    pub transactions: Vec<Pay2sTransaction>,
+}
+
+impl From<&Pay2sWebhook> for Pay2sTransactionsResponse {
+    fn from(webhook: &Pay2sWebhook) -> Self {
+        Self {
+            transactions: webhook.transactions(),
+        }
+    }
+}
+
+pub fn received_amount(transactions: &[Pay2sTransaction], code: &str) -> (i64, Option<String>) {
+    transactions
+        .iter()
+        .filter(|txn| txn.transfer_code().as_deref() == Some(code))
+        .fold((0, None), |(total, reference), txn| {
+            (
+                total + txn.incoming_amount(),
+                reference.or_else(|| txn.transaction_number.clone()),
+            )
+        })
+}
+
+impl<F>
+    TryFrom<
+        ResponseRouterData<F, Pay2sTransactionsResponse, PaymentsSyncData, PaymentsResponseData>,
+    > for RouterData<F, PaymentsSyncData, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<
+            F,
+            Pay2sTransactionsResponse,
+            PaymentsSyncData,
+            PaymentsResponseData,
+        >,
+    ) -> Result<Self, Self::Error> {
+        let code = item
+            .data
+            .request
+            .connector_transaction_id
+            .get_connector_transaction_id()
+            .map_err(|_| errors::ConnectorError::MissingConnectorTransactionID)?;
+        let (received, bank_reference) = received_amount(&item.response.transactions, &code);
+        let expected = item.data.request.amount.get_amount_as_i64();
+        let status = match vn_utils::bank_transfer_status(expected, received) {
+            enums::AttemptStatus::AuthenticationPending => item.data.status,
+            status => status,
+        };
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id: ResponseId::ConnectorTransactionId(code),
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: bank_reference,
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Pay2sErrorResponse {
+    pub status: Option<serde_json::Value>,
+    pub message: Option<String>,
+}
+
+pub fn build_error(response: Pay2sErrorResponse, http_code: u16) -> ErrorResponse {
+    let message = response
+        .message
+        .unwrap_or_else(|| hyperswitch_interfaces::consts::NO_ERROR_MESSAGE.to_string());
+    ErrorResponse {
+        code: response
+            .status
+            .map(|status| status.to_string())
+            .unwrap_or_else(|| http_code.to_string()),
+        message: message.clone(),
+        reason: Some(message),
+        status_code: http_code,
+        attempt_status: None,
+        connector_transaction_id: None,
+        connector_response_reference_id: None,
+        network_advice_code: None,
+        network_decline_code: None,
+        network_error_message: None,
+        connector_metadata: None,
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_batched_webhook() {
+        let code = vn_utils::transfer_code("pay_9");
+        let body = format!(
+            r#"{{"transactions":[{{"id":1,"gateway":"ACB","transactionDate":"2025-01-01 10:00:00","transactionNumber":"FT123","accountNumber":"999","content":"{code} thanh toan","transferType":"IN","transferAmount":150000}}]}}"#
+        );
+        let webhook: Pay2sWebhook = serde_json::from_str(&body).unwrap();
+        assert_eq!(webhook.transfer_code(), Some(code.clone()));
+        let response = Pay2sTransactionsResponse::from(&webhook);
+        assert_eq!(received_amount(&response.transactions, &code).0, 150000);
+    }
+
+    #[test]
+    fn parses_single_snake_case_webhook() {
+        let code = vn_utils::transfer_code("pay_10");
+        let body = format!(
+            r#"{{"transaction_id":"7","account_number":"999","description":"CK {code}","transfer_type":"in","amount":"20000.00"}}"#
+        );
+        let webhook: Pay2sWebhook = serde_json::from_str(&body).unwrap();
+        assert!(webhook.is_incoming());
+        assert_eq!(webhook.transfer_code(), Some(code));
+    }
+
+    #[test]
+    fn ignores_outgoing_transfers() {
+        let code = vn_utils::transfer_code("pay_11");
+        let body = format!(r#"{{"content":"{code}","transferType":"OUT","transferAmount":5}}"#);
+        let webhook: Pay2sWebhook = serde_json::from_str(&body).unwrap();
+        assert_eq!(webhook.transfer_code(), None);
+    }
+
+    #[test]
+    fn vietqr_image_url() {
+        let auth = Pay2sAuthType {
+            api_token: Secret::new("t".into()),
+            account_number: Secret::new("0123".into()),
+            bank: Secret::new("ACB".into()),
+        };
+        assert_eq!(
+            qr_image_url(&auth, 1000, "HTPX").unwrap().as_str(),
+            "https://img.vietqr.io/image/970416-0123-compact2.png?amount=1000&addInfo=HTPX"
+        );
+    }
+}
