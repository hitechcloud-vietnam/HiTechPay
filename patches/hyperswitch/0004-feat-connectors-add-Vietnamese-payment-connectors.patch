+/// Minutes a bank-transfer VietQR is displayed before the customer is asked to retry
+pub const BANK_TRANSFER_QR_EXPIRY_MINUTES: i64 = 30;
+
+/// Authorize response for bank-transfer VietQR gateways (SePay, Pay2S): the QR is rendered
+/// locally and the payment is confirmed later by the gateway's bank transaction webhook.
+/// The transfer code (memo) is the connector transaction id used for reconciliation.
+pub fn build_bank_transfer_authorize_response(
+    data: &hyperswitch_domain_models::types::PaymentsAuthorizeRouterData,
+    bank: &str,
+    account_number: &str,
+    qr_image_url: Option<url::Url>,
+) -> Result<
+    hyperswitch_domain_models::types::PaymentsAuthorizeRouterData,
+    error_stack::Report<errors::ConnectorError>,
+> {
+    use hyperswitch_domain_models::{
+        payment_method_data::{PaymentMethodData, RealTimePaymentData},
+        router_request_types::ResponseId,
+        router_response_types::PaymentsResponseData,
+    };
+    match &data.request.payment_method_data {
+        PaymentMethodData::RealTimePayment(rtp)
+            if matches!(rtp.as_ref(), RealTimePaymentData::VietQr {}) => {}
+        _ => Err(errors::ConnectorError::NotImplemented(
+            crate::utils::get_unimplemented_payment_method_error_message(&data.connector),
+        ))?,
+    }
+    if data.request.currency != common_enums::Currency::VND {
+        Err(errors::ConnectorError::NotSupported {
+            message: format!("currency {}", data.request.currency),
+            connector: "vietqr bank transfer",
+        })?
+    }
+    let bank_bin = resolve_bank_bin(bank).ok_or(errors::ConnectorError::InvalidConnectorConfig {
+        config: "bank code is not a known NAPAS bank (use a short name such as MB, VCB or a 6 digit BIN)",
+    })?;
+    let code = transfer_code(&data.connector_request_reference_id);
+    let amount = data.request.minor_amount.get_amount_as_i64();
+    let payload = build_vietqr_payload(&VietQrData {
+        bank_bin,
+        account_number,
+        amount: Some(amount),
+        memo: Some(&code),
+    });
+    let expires_at = (OffsetDateTime::now_utc()
+        + time::Duration::minutes(BANK_TRANSFER_QR_EXPIRY_MINUTES))
+    .unix_timestamp()
+        * 1000;
+    let connector_metadata = qr_code_metadata(payload, qr_image_url, Some(expires_at))?;
+    Ok(hyperswitch_domain_models::router_data::RouterData {
+        status: common_enums::AttemptStatus::AuthenticationPending,
+        response: Ok(PaymentsResponseData::TransactionResponse {
+            resource_id: ResponseId::ConnectorTransactionId(code.clone()),
+            redirection_data: Box::new(None),
+            mandate_reference: Box::new(None),
+            connector_metadata: Some(connector_metadata),
+            network_txn_id: None,
+            network_txn_link_id: None,
+            connector_response_reference_id: Some(code),
+            incremental_authorization_allowed: None,
+            authentication_data: None,
+            charges: None,
+            payment_account_reference: None,
+        }),
+        ..data.clone()
+    })
+}
+
+/// Parse a bank amount such as `"50000.00"`, `"50,000"` or `50000` into whole VND
+pub fn parse_vnd_amount(value: &serde_json::Value) -> Option<i64> {
+    match value {
+        serde_json::Value::Number(number) => number
+            .as_i64()
+            .or_else(|| number.as_f64().map(|amount| amount.round() as i64)),
+        serde_json::Value::String(text) => {
+            let cleaned: String = text.chars().filter(|c| *c != ',').collect();
+            cleaned.parse::<i64>().ok().or_else(|| {
+                cleaned
+                    .parse::<f64>()
+                    .ok()
+                    .map(|amount| amount.round() as i64)
+            })
+        }
+        _ => None,
+    }
+}
+
+/// Status of a bank-transfer payment given the total amount received for its transfer code
+pub fn bank_transfer_status(expected: i64, received: i64) -> common_enums::AttemptStatus {
+    if received <= 0 {
+        common_enums::AttemptStatus::AuthenticationPending
+    } else if received >= expected {
+        common_enums::AttemptStatus::Charged
+    } else {
+        common_enums::AttemptStatus::PartialCharged
+    }
+}
