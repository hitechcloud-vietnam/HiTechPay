+fn parse_callback(
+    request: &webhooks::IncomingWebhookRequestDetails<'_>,
+) -> CustomResult<(zalopay::ZalopayCallback, zalopay::ZalopayCallbackData), errors::ConnectorError>
+{
+    let callback: zalopay::ZalopayCallback = request
+        .body
+        .parse_struct("ZalopayCallback")
+        .change_context(errors::ConnectorError::WebhookBodyDecodingFailed)?;
+    let data: zalopay::ZalopayCallbackData = callback
+        .data
+        .as_bytes()
+        .parse_struct("ZalopayCallbackData")
+        .change_context(errors::ConnectorError::WebhookBodyDecodingFailed)?;
+    Ok((callback, data))
+}
