+pub const VNPAY_VERSION: &str = "2.1.0";
+const DEFAULT_IP: &str = "127.0.0.1";
+const PAYMENT_EXPIRY_MINUTES: i64 = 15;
+pub const VNPAY_SANDBOX_PAYMENT_URL: &str = "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html";
+pub const VNPAY_PRODUCTION_PAYMENT_URL: &str = "https://pay.vnpay.vn/vpcpay.html";
+
+pub struct VnpayRouterData<T> {
+    pub amount: MinorUnit,
+    pub router_data: T,
+}
