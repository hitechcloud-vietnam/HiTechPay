index 0000000..03b0c9e
--- /dev/null
+++ b/crates/hyperswitch_connectors/src/connectors/viettelmoney/transformers.rs
@@ -0,0 +1,431 @@
+//! Viettel Money (ViettelPay payment gateway, version 2.0) transformers.
+//!
+//! * Pay    : redirect to `PaymentGateway/payment?<params>&check_sum=<base64 HMAC-SHA1>` (built
+//!            locally), check_sum over
+//!            `access_code + billcode + command + merchant_code + order_id + trans_amount + version`
+//! * Result : Viettel calls the merchant result URL (IPN) and redirects the customer to
+//!            `return_url` with `billcode, cust_msisdn, error_code, merchant_code, order_id,
+//!            payment_status, trans_amount, vt_transaction_id, check_sum` where check_sum is over
+//!            `access_code + billcode + cust_msisdn + error_code + merchant_code + order_id +
+//!            payment_status + trans_amount + vt_transaction_id`
+//! * PSync  : resolved locally from the IPN or the signed return parameters.
+//!
+//! NOTE: Viettel Money partner specs are distributed privately to merchants. Validate the
+//! field list against the integration document received from Viettel before going live.
+
+use std::collections::BTreeMap;
+
+use common_enums::enums;
+use common_utils::types::MinorUnit;
+use error_stack::ResultExt;
+use hyperswitch_domain_models::{
+    payment_method_data::{BankRedirectData, PaymentMethodData, RealTimePaymentData},
+    router_data::{ConnectorAuthType, ErrorResponse, RouterData},
+    router_request_types::{PaymentsSyncData, ResponseId},
+    router_response_types::{PaymentsResponseData, RedirectForm},
+    types::PaymentsAuthorizeRouterData,
+};
+use hyperswitch_interfaces::errors;
+use hyperswitch_masking::{PeekInterface, Secret};
+use serde::{Deserialize, Serialize};
+
+use crate::{types::ResponseRouterData, utils::PaymentsAuthorizeRequestData, vn_utils};
+
+pub const VIETTEL_VERSION: &str = "2.0";
+pub const VIETTEL_COMMAND_PAYMENT: &str = "PAYMENT";
+pub const VIETTEL_SANDBOX_PAYMENT_URL: &str = "https://sandbox.viettel.vn/PaymentGateway/payment";
+pub const VIETTEL_PRODUCTION_PAYMENT_URL: &str = "https://pay3.viettel.vn/PaymentGateway/payment";
+
+pub struct ViettelmoneyRouterData<T> {
+    pub amount: MinorUnit,
+    pub router_data: T,
+}
+
+impl<T> From<(MinorUnit, T)> for ViettelmoneyRouterData<T> {
+    fn from((amount, item): (MinorUnit, T)) -> Self {
+        Self {
+            amount,
+            router_data: item,
+        }
+    }
+}
+
+pub struct ViettelmoneyAuthType {
+    pub merchant_code: Secret<String>,
+    pub access_code: Secret<String>,
+    pub hash_key: Secret<String>,
+}
+
+impl TryFrom<&ConnectorAuthType> for ViettelmoneyAuthType {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(auth_type: &ConnectorAuthType) -> Result<Self, Self::Error> {
+        match auth_type {
+            ConnectorAuthType::SignatureKey {
+                api_key,
+                key1,
+                api_secret,
+            } => Ok(Self {
+                merchant_code: api_key.to_owned(),
+                access_code: key1.to_owned(),
+                hash_key: api_secret.to_owned(),
+            }),
+            _ => Err(errors::ConnectorError::FailedToObtainAuthType.into()),
+        }
+    }
+}
+
+impl ViettelmoneyAuthType {
+    pub fn checksum(
+        &self,
+        data: &str,
+    ) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+        vn_utils::hmac_sha1_base64(self.hash_key.peek(), data)
+    }
+}
+
+/// Build the signed Viettel Money payment page URL.
+pub fn build_payment_url(
+    item: &ViettelmoneyRouterData<&PaymentsAuthorizeRouterData>,
+) -> Result<url::Url, error_stack::Report<errors::ConnectorError>> {
+    let router_data = item.router_data;
+    if router_data.request.currency != enums::Currency::VND {
+        Err(errors::ConnectorError::NotSupported {
+            message: format!("currency {}", router_data.request.currency),
+            connector: "viettelmoney",
+        })?
+    }
+    match &router_data.request.payment_method_data {
+        PaymentMethodData::RealTimePayment(rtp)
+            if matches!(rtp.as_ref(), RealTimePaymentData::VietQr {}) => {}
+        PaymentMethodData::BankRedirect(BankRedirectData::LocalBankRedirect {}) => {}
+        _ => Err(errors::ConnectorError::NotImplemented(
+            crate::utils::get_unimplemented_payment_method_error_message("viettelmoney"),
+        ))?,
+    }
+    let auth = ViettelmoneyAuthType::try_from(&router_data.connector_auth_type)?;
+    let base_url = vn_utils::resolve_hosted_payment_url(
+        router_data.connector_meta_data.as_ref(),
+        router_data.test_mode,
+        VIETTEL_SANDBOX_PAYMENT_URL,
+        VIETTEL_PRODUCTION_PAYMENT_URL,
+    );
+    let order_id = router_data.connector_request_reference_id.clone();
+    let billcode = order_id.clone();
+    let trans_amount = item.amount.get_amount_as_i64().to_string();
+    let return_url = router_data.request.get_router_return_url()?;
+    let locale = match router_data
+        .request
+        .browser_info
+        .as_ref()
+        .and_then(|b| b.language.as_ref())
+        .map(|l| l.to_ascii_lowercase())
+    {
+        Some(lang) if lang.starts_with("en") => "En",
+        _ => "Vi",
+    };
+    let check_sum = auth.checksum(&format!(
+        "{}{billcode}{VIETTEL_COMMAND_PAYMENT}{}{order_id}{trans_amount}{VIETTEL_VERSION}",
+        auth.access_code.peek(),
+        auth.merchant_code.peek(),
+    ))?;
+    let desc = vn_utils::sanitize_memo(
+        &router_data
+            .description
+            .clone()
+            .unwrap_or_else(|| format!("Thanh toan don hang {order_id}")),
+        200,
+    );
+    url::Url::parse_with_params(
+        &base_url,
+        &[
+            ("billcode", billcode.as_str()),
+            ("command", VIETTEL_COMMAND_PAYMENT),
+            ("desc", desc.as_str()),
+            ("locale", locale),
+            ("merchant_code", auth.merchant_code.peek().as_str()),
+            ("order_id", order_id.as_str()),
+            ("return_url", return_url.as_str()),
+            ("cancel_url", return_url.as_str()),
+            ("trans_amount", trans_amount.as_str()),
+            ("version", VIETTEL_VERSION),
+            ("check_sum", check_sum.as_str()),
+        ],
+    )
+    .change_context(errors::ConnectorError::RequestEncodingFailed)
+}
+
+pub fn build_authorize_response(
+    data: &PaymentsAuthorizeRouterData,
+    url: url::Url,
+) -> PaymentsAuthorizeRouterData {
+    let order_id = data.connector_request_reference_id.clone();
+    RouterData {
+        status: enums::AttemptStatus::AuthenticationPending,
+        response: Ok(PaymentsResponseData::TransactionResponse {
+            resource_id: ResponseId::ConnectorTransactionId(order_id.clone()),
+            redirection_data: Box::new(Some(RedirectForm::from((
+                url,
+                common_utils::request::Method::Get,
+            )))),
+            mandate_reference: Box::new(None),
+            connector_metadata: None,
+            network_txn_id: None,
+            network_txn_link_id: None,
+            connector_response_reference_id: Some(order_id),
+            incremental_authorization_allowed: None,
+            authentication_data: None,
+            charges: None,
+            payment_account_reference: None,
+        }),
+        ..data.clone()
+    }
+}
+
+/// Payment result sent by Viettel Money (IPN body or return URL parameters)
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ViettelmoneyResult {
+    pub billcode: Option<String>,
+    pub cust_msisdn: Option<String>,
+    pub error_code: Option<String>,
+    pub merchant_code: Option<String>,
+    pub order_id: Option<String>,
+    pub payment_status: Option<String>,
+    pub trans_amount: Option<String>,
+    pub vt_transaction_id: Option<String>,
+    pub check_sum: Option<String>,
+}
+
+impl ViettelmoneyResult {
+    pub fn from_urlencoded(input: &str) -> Self {
+        let input = input.trim_start_matches('?');
+        let map: BTreeMap<String, String> = url::form_urlencoded::parse(input.as_bytes())
+            .into_owned()
+            .collect();
+        serde_json::to_value(&map)
+            .ok()
+            .and_then(|value| serde_json::from_value(value).ok())
+            .unwrap_or_default()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.order_id.is_none() && self.error_code.is_none()
+    }
+
+    fn field(value: &Option<String>) -> &str {
+        value.as_deref().unwrap_or_default()
+    }
+
+    pub fn checksum_payload(&self, access_code: &str) -> String {
+        format!(
+            "{access_code}{}{}{}{}{}{}{}{}",
+            Self::field(&self.billcode),
+            Self::field(&self.cust_msisdn),
+            Self::field(&self.error_code),
+            Self::field(&self.merchant_code),
+            Self::field(&self.order_id),
+            Self::field(&self.payment_status),
+            Self::field(&self.trans_amount),
+            Self::field(&self.vt_transaction_id),
+        )
+    }
+
+    pub fn verify(&self, auth: &ViettelmoneyAuthType) -> bool {
+        let Some(received) = self.check_sum.as_deref() else {
+            return false;
+        };
+        auth.checksum(&self.checksum_payload(auth.access_code.peek()))
+            .map(|expected| vn_utils::secure_eq(&expected, received.trim()))
+            .unwrap_or(false)
+    }
+
+    pub fn attempt_status(&self) -> enums::AttemptStatus {
+        match (self.error_code.as_deref(), self.payment_status.as_deref()) {
+            (Some("00"), Some("1")) => enums::AttemptStatus::Charged,
+            (Some("00"), Some("0")) | (Some("00"), None) => enums::AttemptStatus::Pending,
+            (Some("V04"), _) | (Some("W04"), _) => enums::AttemptStatus::AuthenticationFailed,
+            (Some(_), _) => enums::AttemptStatus::Failure,
+            (None, _) => enums::AttemptStatus::AuthenticationPending,
+        }
+    }
+}
+
+/// PSync: status from the webhook resource object (JSON) or from the signed return
+/// parameters (`encoded_data`). Without either, the current status is kept.
+impl<F> TryFrom<ResponseRouterData<F, ViettelmoneyResult, PaymentsSyncData, PaymentsResponseData>>
+    for RouterData<F, PaymentsSyncData, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<F, ViettelmoneyResult, PaymentsSyncData, PaymentsResponseData>,
+    ) -> Result<Self, Self::Error> {
+        let auth = ViettelmoneyAuthType::try_from(&item.data.connector_auth_type)?;
+        let result = if item.response.is_empty() {
+            item.data
+                .request
+                .encoded_data
+                .as_deref()
+                .map(ViettelmoneyResult::from_urlencoded)
+                .filter(|result| !result.is_empty() && result.verify(&auth))
+        } else {
+            Some(item.response)
+        };
+        let current_id = item
+            .data
+            .request
+            .connector_transaction_id
+            .get_connector_transaction_id()
+            .ok();
+        let Some(result) = result else {
+            return Ok(Self {
+                response: Ok(PaymentsResponseData::TransactionResponse {
+                    resource_id: current_id
+                        .map(ResponseId::ConnectorTransactionId)
+                        .unwrap_or(ResponseId::NoResponseId),
+                    redirection_data: Box::new(None),
+                    mandate_reference: Box::new(None),
+                    connector_metadata: None,
+                    network_txn_id: None,
+                    network_txn_link_id: None,
+                    connector_response_reference_id: None,
+                    incremental_authorization_allowed: None,
+                    authentication_data: None,
+                    charges: None,
+                    payment_account_reference: None,
+                }),
+                ..item.data
+            });
+        };
+        let status = result.attempt_status();
+        if matches!(
+            status,
+            enums::AttemptStatus::Failure | enums::AttemptStatus::AuthenticationFailed
+        ) {
+            let code = result.error_code.clone().unwrap_or_default();
+            return Ok(Self {
+                status,
+                response: Err(ErrorResponse {
+                    code: code.clone(),
+                    message: format!("Viettel Money error {code}"),
+                    reason: None,
+                    status_code: item.http_code,
+                    attempt_status: Some(status),
+                    connector_transaction_id: result.vt_transaction_id.clone(),
+                    connector_response_reference_id: result.order_id.clone(),
+                    network_advice_code: None,
+                    network_decline_code: None,
+                    network_error_message: None,
+                    connector_metadata: None,
+                }),
+                ..item.data
+            });
+        }
+        let resource_id = result
+            .vt_transaction_id
+            .clone()
+            .filter(|id| !id.is_empty())
+            .or(current_id)
+            .map(ResponseId::ConnectorTransactionId)
+            .unwrap_or(ResponseId::NoResponseId);
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id,
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: result.order_id,
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+/// IPN acknowledgement expected by Viettel Money
+#[derive(Debug, Clone, Serialize)]
+pub struct ViettelmoneyIpnResponse {
+    pub error_code: String,
+    pub merchant_code: String,
+    pub order_id: String,
+    pub return_url: String,
+    pub return_bill_code: String,
+    pub return_other_info: String,
+    pub check_sum: String,
+}
+
+impl ViettelmoneyIpnResponse {
+    pub fn new(
+        auth: &ViettelmoneyAuthType,
+        result: &ViettelmoneyResult,
+        error_code: &str,
+    ) -> Result<Self, error_stack::Report<errors::ConnectorError>> {
+        let merchant_code = auth.merchant_code.peek().clone();
+        let order_id = result.order_id.clone().unwrap_or_default();
+        let return_bill_code = result.billcode.clone().unwrap_or_default();
+        let check_sum = auth.checksum(&format!(
+            "{}{error_code}{merchant_code}{order_id}{return_bill_code}",
+            auth.access_code.peek()
+        ))?;
+        Ok(Self {
+            error_code: error_code.to_string(),
+            merchant_code,
+            order_id,
+            return_url: String::new(),
+            return_bill_code,
+            return_other_info: String::new(),
+            check_sum,
+        })
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    fn auth() -> ViettelmoneyAuthType {
+        ViettelmoneyAuthType {
+            merchant_code: Secret::new("HITECH".into()),
+            access_code: Secret::new("ACCESS".into()),
+            hash_key: Secret::new("HASH".into()),
+        }
+    }
+
+    #[test]
+    fn verifies_result_checksum() {
+        let auth = auth();
+        let mut result = ViettelmoneyResult {
+            billcode: Some("pay_1".into()),
+            cust_msisdn: Some("84987654321".into()),
+            error_code: Some("00".into()),
+            merchant_code: Some("HITECH".into()),
+            order_id: Some("pay_1".into()),
+            payment_status: Some("1".into()),
+            trans_amount: Some("10000".into()),
+            vt_transaction_id: Some("123456".into()),
+            check_sum: None,
+        };
+        let payload = result.checksum_payload("ACCESS");
+        assert_eq!(payload, "ACCESSpay_18498765432100HITECHpay_1110000123456");
+        result.check_sum = Some(auth.checksum(&payload).unwrap());
+        assert!(result.verify(&auth));
+        assert_eq!(result.attempt_status(), enums::AttemptStatus::Charged);
+        result.trans_amount = Some("1".into());
+        assert!(!result.verify(&auth));
+    }
+
+    #[test]
+    fn parses_return_query() {
+        let result = ViettelmoneyResult::from_urlencoded(
+            "?billcode=b&error_code=00&order_id=pay_1&payment_status=0&check_sum=abc%3D",
+        );
+        assert_eq!(result.order_id.as_deref(), Some("pay_1"));
+        assert_eq!(result.check_sum.as_deref(), Some("abc="));
+        assert_eq!(result.attempt_status(), enums::AttemptStatus::Pending);
+    }
+}
diff --git a/crates/hyperswitch_connectors/src/connectors/vnpay.rs b/crates/hyperswitch_connectors/src/connectors/vnpay.rs
