@@ -0,0 +1,321 @@
+//! SePay transformers (bank transfer reconciliation via VietQR).
+//!
+//! Flow
+//! 1. Authorize: a dynamic VietQR is rendered locally for the merchant bank account with a
+//!    HiTechPay transfer code (e.g. `HTP4F1C0A9B22D7`) as the transfer memo. No API call.
+//! 2. The customer transfers money; SePay detects it and calls the webhook:
+//!    `POST {id, gateway, transactionDate, accountNumber, code, content, transferType,
+//!    transferAmount, accumulated, subAccount, referenceCode, description}` with header
+//!    `Authorization: Apikey <webhook api key>`.
+//! 3. PSync: `GET /userapi/transactions/list?account_number=..` (header
+//!    `Authorization: Bearer <API token>`) and sum the incoming transfers carrying the code.
+//!
+//! Refunds are not supported by SePay (merchant transfers money back manually).
+
+use common_enums::enums;
+use hyperswitch_domain_models::{
+    router_data::{ConnectorAuthType, ErrorResponse, RouterData},
+    router_request_types::{PaymentsSyncData, ResponseId},
+    router_response_types::PaymentsResponseData,
+};
+use hyperswitch_interfaces::errors;
+use hyperswitch_masking::{PeekInterface, Secret};
+use serde::{Deserialize, Serialize};
+
+use crate::{types::ResponseRouterData, vn_utils};
+
+pub const SEPAY_QR_IMAGE_URL: &str = "https://qr.sepay.vn/img";
+pub const TRANSACTION_LIST_LIMIT: u32 = 100;
+
+pub struct SepayAuthType {
+    pub api_token: Secret<String>,
+    pub account_number: Secret<String>,
+    pub bank: Secret<String>,
+}
+
+impl TryFrom<&ConnectorAuthType> for SepayAuthType {
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(auth_type: &ConnectorAuthType) -> Result<Self, Self::Error> {
+        match auth_type {
+            ConnectorAuthType::SignatureKey {
+                api_key,
+                key1,
+                api_secret,
+            } => Ok(Self {
+                api_token: api_key.to_owned(),
+                account_number: key1.to_owned(),
+                bank: api_secret.to_owned(),
+            }),
+            _ => Err(errors::ConnectorError::FailedToObtainAuthType.into()),
+        }
+    }
+}
+
+/// `https://qr.sepay.vn/img?acc=..&bank=..&amount=..&des=..`
+pub fn qr_image_url(auth: &SepayAuthType, amount: i64, memo: &str) -> Option<url::Url> {
+    url::Url::parse_with_params(
+        SEPAY_QR_IMAGE_URL,
+        &[
+            ("acc", auth.account_number.peek().as_str()),
+            ("bank", auth.bank.peek().as_str()),
+            ("amount", amount.to_string().as_str()),
+            ("des", memo),
+        ],
+    )
+    .ok()
+}
+
+/// A bank transaction, from either the user API or the webhook.
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+pub struct SepayTransaction {
+    pub id: Option<serde_json::Value>,
+    pub transaction_content: Option<String>,
+    pub code: Option<String>,
+    pub amount_in: Option<serde_json::Value>,
+    pub amount_out: Option<serde_json::Value>,
+    pub reference_number: Option<String>,
+    pub transaction_date: Option<String>,
+    pub account_number: Option<String>,
+}
+
+impl SepayTransaction {
+    pub fn transfer_code(&self) -> Option<String> {
+        self.code
+            .as_deref()
+            .and_then(vn_utils::extract_transfer_code)
+            .or_else(|| {
+                self.transaction_content
+                    .as_deref()
+                    .and_then(vn_utils::extract_transfer_code)
+            })
+    }
+
+    pub fn incoming_amount(&self) -> i64 {
+        self.amount_in
+            .as_ref()
+            .and_then(vn_utils::parse_vnd_amount)
+            .unwrap_or_default()
+    }
+}
+
+/// `GET /userapi/transactions/list` response. Webhooks are converted into this shape so
+/// that PSync handles both.
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+pub struct SepayTransactionsResponse {
+    pub status: Option<i64>,
+    pub error: Option<serde_json::Value>,
+    #[serde(default)]
+    pub transactions: Vec<SepayTransaction>,
+}
+
+/// SePay webhook body
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SepayWebhook {
+    pub id: Option<serde_json::Value>,
+    pub gateway: Option<String>,
+    pub transaction_date: Option<String>,
+    pub account_number: Option<String>,
+    pub code: Option<String>,
+    pub content: Option<String>,
+    pub transfer_type: Option<String>,
+    pub transfer_amount: Option<serde_json::Value>,
+    pub accumulated: Option<serde_json::Value>,
+    pub reference_code: Option<String>,
+    pub description: Option<String>,
+}
+
+impl SepayWebhook {
+    pub fn is_incoming(&self) -> bool {
+        self.transfer_type
+            .as_deref()
+            .map(|kind| kind.eq_ignore_ascii_case("in"))
+            .unwrap_or(false)
+    }
+
+    pub fn transfer_code(&self) -> Option<String> {
+        self.code
+            .as_deref()
+            .and_then(vn_utils::extract_transfer_code)
+            .or_else(|| {
+                self.content
+                    .as_deref()
+                    .and_then(vn_utils::extract_transfer_code)
+            })
+            .or_else(|| {
+                self.description
+                    .as_deref()
+                    .and_then(vn_utils::extract_transfer_code)
+            })
+    }
+}
+
+impl From<&SepayWebhook> for SepayTransactionsResponse {
+    fn from(webhook: &SepayWebhook) -> Self {
+        let transfer_amount = if webhook.is_incoming() {
+            webhook.transfer_amount.clone()
+        } else {
+            None
+        };
+        Self {
+            status: Some(200),
+            error: None,
+            transactions: vec![SepayTransaction {
+                id: webhook.id.clone(),
+                transaction_content: webhook.content.clone(),
+                code: webhook.code.clone(),
+                amount_in: transfer_amount,
+                amount_out: None,
+                reference_number: webhook.reference_code.clone(),
+                transaction_date: webhook.transaction_date.clone(),
+                account_number: webhook.account_number.clone(),
+            }],
+        }
+    }
+}
+
+/// Total amount received for a transfer code
+pub fn received_amount(transactions: &[SepayTransaction], code: &str) -> (i64, Option<String>) {
+    transactions
+        .iter()
+        .filter(|txn| txn.transfer_code().as_deref() == Some(code))
+        .fold((0, None), |(total, reference), txn| {
+            (
+                total + txn.incoming_amount(),
+                reference.or_else(|| txn.reference_number.clone()),
+            )
+        })
+}
+
+impl<F>
+    TryFrom<
+        ResponseRouterData<F, SepayTransactionsResponse, PaymentsSyncData, PaymentsResponseData>,
+    > for RouterData<F, PaymentsSyncData, PaymentsResponseData>
+{
+    type Error = error_stack::Report<errors::ConnectorError>;
+    fn try_from(
+        item: ResponseRouterData<
+            F,
+            SepayTransactionsResponse,
+            PaymentsSyncData,
+            PaymentsResponseData,
+        >,
+    ) -> Result<Self, Self::Error> {
+        let code = item
+            .data
+            .request
+            .connector_transaction_id
+            .get_connector_transaction_id()
+            .map_err(|_| errors::ConnectorError::MissingConnectorTransactionID)?;
+        let (received, bank_reference) = received_amount(&item.response.transactions, &code);
+        let expected = item.data.request.amount.get_amount_as_i64();
+        let status = vn_utils::bank_transfer_status(expected, received);
+        let status = if status == enums::AttemptStatus::AuthenticationPending {
+            // keep whatever status the attempt already had (e.g. after a webhook)
+            item.data.status
+        } else {
+            status
+        };
+        Ok(Self {
+            status,
+            response: Ok(PaymentsResponseData::TransactionResponse {
+                resource_id: ResponseId::ConnectorTransactionId(code),
+                redirection_data: Box::new(None),
+                mandate_reference: Box::new(None),
+                connector_metadata: None,
+                network_txn_id: None,
+                network_txn_link_id: None,
+                connector_response_reference_id: bank_reference,
+                incremental_authorization_allowed: None,
+                authentication_data: None,
+                charges: None,
+                payment_account_reference: None,
+            }),
+            ..item.data
+        })
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SepayErrorResponse {
+    pub status: Option<i64>,
+    pub error: Option<serde_json::Value>,
+    pub messages: Option<serde_json::Value>,
+}
+
+pub fn build_error(response: SepayErrorResponse, http_code: u16) -> ErrorResponse {
+    let message = response
+        .error
+        .as_ref()
+        .map(|error| match error {
+            serde_json::Value::String(text) => text.clone(),
+            other => other.to_string(),
+        })
+        .unwrap_or_else(|| hyperswitch_interfaces::consts::NO_ERROR_MESSAGE.to_string());
+    ErrorResponse {
+        code: response
+            .status
+            .map(|status| status.to_string())
+            .unwrap_or_else(|| http_code.to_string()),
+        message: message.clone(),
+        reason: Some(message),
+        status_code: http_code,
+        attempt_status: None,
+        connector_transaction_id: None,
+        connector_response_reference_id: None,
+        network_advice_code: None,
+        network_decline_code: None,
+        network_error_message: None,
+        connector_metadata: None,
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn webhook_to_transactions() {
+        let code = vn_utils::transfer_code("pay_1");
+        let body = format!(
+            r#"{{"id":92704,"gateway":"Vietcombank","transactionDate":"2023-03-25 14:02:37","accountNumber":"0123499999","code":null,"content":"chuyen tien {code} mua hang","transferType":"in","transferAmount":2277000,"accumulated":19077000,"subAccount":null,"referenceCode":"MBVCB.3278907687","description":""}}"#
+        );
+        let webhook: SepayWebhook = serde_json::from_str(&body).unwrap();
+        assert!(webhook.is_incoming());
+        assert_eq!(webhook.transfer_code(), Some(code.clone()));
+        let txns = SepayTransactionsResponse::from(&webhook);
+        let (received, reference) = received_amount(&txns.transactions, &code);
+        assert_eq!(received, 2277000);
+        assert_eq!(reference.as_deref(), Some("MBVCB.3278907687"));
+    }
+
+    #[test]
+    fn api_transactions_sum() {
+        let code = vn_utils::transfer_code("pay_2");
+        let body = format!(
+            r#"{{"status":200,"error":null,"messages":{{"success":true}},"transactions":[{{"id":"1","transaction_content":"{code}","amount_in":"30000.00","amount_out":"0.00","reference_number":"A"}},{{"id":"2","transaction_content":"x {code}","amount_in":"20000.00","amount_out":"0.00","reference_number":"B"}},{{"id":"3","transaction_content":"other","amount_in":"99000.00","amount_out":"0.00"}}]}}"#
+        );
+        let response: SepayTransactionsResponse = serde_json::from_str(&body).unwrap();
+        let (received, _) = received_amount(&response.transactions, &code);
+        assert_eq!(received, 50000);
+        assert_eq!(
+            vn_utils::bank_transfer_status(50000, received),
+            enums::AttemptStatus::Charged
+        );
+    }
+
+    #[test]
+    fn qr_image() {
+        let auth = SepayAuthType {
+            api_token: Secret::new("t".into()),
+            account_number: Secret::new("0123".into()),
+            bank: Secret::new("MBBank".into()),
+        };
+        let url = qr_image_url(&auth, 10000, "HTPABC").unwrap();
+        assert_eq!(
+            url.as_str(),
+            "https://qr.sepay.vn/img?acc=0123&bank=MBBank&amount=10000&des=HTPABC"
+        );
+    }
+}
