+fn refund_status(data: &VnpayTransactionData) -> enums::RefundStatus {
+    if data.vnp_ResponseCode.as_deref() != Some("00") {
+        return enums::RefundStatus::Failure;
+    }
+    match data.vnp_TransactionStatus.as_deref() {
+        Some("00") | Some("06") => enums::RefundStatus::Success,
+        Some("05") | Some("01") => enums::RefundStatus::Pending,
+        Some("09") | Some("02") => enums::RefundStatus::Failure,
+        _ => enums::RefundStatus::Pending,
+    }
+}
+
+fn refund_error(data: &VnpayTransactionData, http_code: u16) -> ErrorResponse {
+    let code = data.vnp_ResponseCode.clone().unwrap_or_default();
+    ErrorResponse {
+        code: code.clone(),
+        message: data
+            .vnp_Message
+            .clone()
+            .unwrap_or_else(|| response_code_message(&code).to_string()),
+        reason: Some(response_code_message(&code).to_string()),
+        status_code: http_code,
+        attempt_status: None,
+        connector_transaction_id: data.vnp_TransactionNo.clone(),
+        connector_response_reference_id: None,
+        network_advice_code: None,
+        network_decline_code: None,
+        network_error_message: None,
+        connector_metadata: None,
+    }
+}
