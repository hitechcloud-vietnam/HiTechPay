+static SEPAY_SUPPORTED_WEBHOOK_FLOWS: [enums::EventClass; 1] = [enums::EventClass::Payments];
+
+impl ConnectorSpecifications for Sepay {
+    fn get_connector_about(&self) -> Option<&'static ConnectorInfo> {
+        Some(&SEPAY_CONNECTOR_INFO)
+    }
+
+    fn get_supported_payment_methods(&self) -> Option<&'static SupportedPaymentMethods> {
+        Some(&*SEPAY_SUPPORTED_PAYMENT_METHODS)
+    }
+
+    fn get_supported_webhook_flows(&self) -> Option<&'static [enums::EventClass]> {
+        Some(&SEPAY_SUPPORTED_WEBHOOK_FLOWS)
+    }
+
+    fn should_build_authorize_response_locally(&self) -> bool {
+        true
+    }
+}
diff --git a/crates/hyperswitch_connectors/src/connectors/sepay/transformers.rs b/crates/hyperswitch_connectors/src/connectors/sepay/transformers.rs
