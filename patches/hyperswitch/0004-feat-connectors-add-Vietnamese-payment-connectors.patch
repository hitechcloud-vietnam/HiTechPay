+#[async_trait::async_trait]
+impl webhooks::IncomingWebhook for Zalopay {
+    async fn verify_webhook_source(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        _merchant_id: &common_utils::id_type::MerchantId,
+        _connector_webhook_details: Option<common_utils::pii::SecretSerdeValue>,
+        connector_account_details: crypto::Encryptable<
+            hyperswitch_masking::Secret<serde_json::Value>,
+        >,
+        _connector_label: &str,
+    ) -> CustomResult<bool, errors::ConnectorError> {
+        let auth_type: ConnectorAuthType = connector_account_details
+            .parse_value::<ConnectorAuthType>("ConnectorAuthType")
+            .change_context(errors::ConnectorError::WebhookSourceVerificationFailed)?;
+        let auth = zalopay::ZalopayAuthType::try_from(&auth_type)?;
+        let (callback, _) = parse_callback(request)?;
+        let expected = vn_utils::hmac_sha256_hex(auth.key2.peek(), &callback.data)?;
+        Ok(vn_utils::secure_eq(
+            &expected,
+            &callback.mac.to_ascii_lowercase(),
+        ))
+    }
+
+    fn get_webhook_object_reference_id(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+    ) -> CustomResult<api_models::webhooks::ObjectReferenceId, errors::ConnectorError> {
+        let (_, data) = parse_callback(request)?;
+        Ok(match data.hitechpay_ref() {
+            Some(attempt_id) => api_models::webhooks::ObjectReferenceId::PaymentId(
+                api_models::payments::PaymentIdType::PaymentAttemptId(attempt_id),
+            ),
+            None => api_models::webhooks::ObjectReferenceId::PaymentId(
+                api_models::payments::PaymentIdType::ConnectorTransactionId(data.app_trans_id),
+            ),
+        })
+    }
+
+    fn get_webhook_event_type(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        _context: Option<&webhooks::WebhookContext>,
+    ) -> CustomResult<api_models::webhooks::IncomingWebhookEvent, errors::ConnectorError> {
+        let (callback, _) = parse_callback(request)?;
+        Ok(match callback.callback_type {
+            None | Some(1) => api_models::webhooks::IncomingWebhookEvent::PaymentIntentSuccess,
+            Some(_) => api_models::webhooks::IncomingWebhookEvent::EventNotSupported,
+        })
+    }
+
+    fn get_webhook_resource_object(
+        &self,
+        request: &webhooks::IncomingWebhookRequestDetails<'_>,
+    ) -> CustomResult<Box<dyn hyperswitch_masking::ErasedMaskSerialize>, errors::ConnectorError>
+    {
+        let (_, data) = parse_callback(request)?;
+        Ok(Box::new(zalopay::ZalopayQueryResponse::from(&data)))
+    }
+
+    fn get_webhook_api_response(
+        &self,
+        _request: &webhooks::IncomingWebhookRequestDetails<'_>,
+        error_kind: Option<webhooks::IncomingWebhookFlowError>,
+        _connector_authentication_type: Option<
+            crypto::Encryptable<hyperswitch_masking::Secret<serde_json::Value>>,
+        >,
+    ) -> CustomResult<
+        hyperswitch_domain_models::api::WebhookResponse<serde_json::Value>,
+        errors::ConnectorError,
+    > {
+        // return_code 1: processed, 2: duplicated, 0 (or other): ZaloPay retries up to 3 times
+        let body = match error_kind {
+            None => serde_json::json!({"return_code": 1, "return_message": "success"}),
+            Some(_) => serde_json::json!({"return_code": 0, "return_message": "retry"}),
+        };
+        Ok(hyperswitch_domain_models::api::WebhookResponse::Json(body))
+    }
+}
+
+static ZALOPAY_SUPPORTED_PAYMENT_METHODS: LazyLock<SupportedPaymentMethods> = LazyLock::new(|| {
+    let supported_capture_methods = vec![
+        enums::CaptureMethod::Automatic,
+        enums::CaptureMethod::SequentialAutomatic,
+    ];
+
+    let mut zalopay_supported_payment_methods = SupportedPaymentMethods::new();
+
+    zalopay_supported_payment_methods.add(
+        enums::PaymentMethod::RealTimePayment,
+        enums::PaymentMethodType::VietQr,
+        PaymentMethodDetails {
+            mandates: enums::FeatureStatus::NotSupported,
+            refunds: enums::FeatureStatus::Supported,
+            supported_capture_methods: supported_capture_methods.clone(),
+            specific_features: None,
+        },
+    );
+
+    zalopay_supported_payment_methods.add(
+        enums::PaymentMethod::BankRedirect,
+        enums::PaymentMethodType::LocalBankRedirect,
+        PaymentMethodDetails {
+            mandates: enums::FeatureStatus::NotSupported,
+            refunds: enums::FeatureStatus::Supported,
+            supported_capture_methods: supported_capture_methods.clone(),
+            specific_features: None,
+        },
+    );
+
+    zalopay_supported_payment_methods
+});
+
+static ZALOPAY_CONNECTOR_INFO: ConnectorInfo = ConnectorInfo {
+    display_name: "ZaloPay",
+    description: "ZaloPay e-wallet (VNG): payments via the ZaloPay app, VietQR from any banking app, and domestic or international cards.",
+    connector_type: enums::HyperswitchConnectorCategory::AlternativePaymentMethod,
+    integration_status: enums::ConnectorIntegrationStatus::Sandbox,
+};
+
+static ZALOPAY_SUPPORTED_WEBHOOK_FLOWS: [enums::EventClass; 1] = [enums::EventClass::Payments];
+
+impl ConnectorSpecifications for Zalopay {
+    fn get_connector_about(&self) -> Option<&'static ConnectorInfo> {
+        Some(&ZALOPAY_CONNECTOR_INFO)
+    }
+
+    fn get_supported_payment_methods(&self) -> Option<&'static SupportedPaymentMethods> {
+        Some(&*ZALOPAY_SUPPORTED_PAYMENT_METHODS)
+    }
+
+    fn get_supported_webhook_flows(&self) -> Option<&'static [enums::EventClass]> {
+        Some(&ZALOPAY_SUPPORTED_WEBHOOK_FLOWS)
+    }
+}
