+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn crc16_matches_reference_vector() {
+        // CRC-16/CCITT-FALSE check value
+        assert_eq!(crc16_ccitt(b"123456789"), 0x29B1);
+    }
+
+    #[test]
+    fn vietqr_payload_is_well_formed() {
+        let payload = build_vietqr_payload(&VietQrData {
+            bank_bin: "970422",
+            account_number: "0123456789",
+            amount: Some(150000),
+            memo: Some("HTP4F1C0A9B22D7"),
+        });
+        assert!(payload.starts_with("000201010212"));
+        assert!(payload.contains("0010A000000727"));
+        assert!(payload.contains("0006970422"));
+        assert!(payload.contains("01100123456789"));
+        assert!(payload.contains("5303704"));
+        assert!(payload.contains("5406150000"));
+        assert!(payload.contains("5802VN"));
+        assert!(payload.contains("0815HTP4F1C0A9B22D7"));
+        let (body, crc) = payload.split_at(payload.len() - 4);
+        assert_eq!(format!("{:04X}", crc16_ccitt(body.as_bytes())), crc);
+    }
+
+    #[test]
+    fn transfer_code_roundtrip() {
+        let code = transfer_code("pay_abc_1");
+        assert_eq!(code.len(), 15);
+        let memo = format!("ck {} thanh toan don hang", code.to_lowercase());
+        assert_eq!(extract_transfer_code(&memo), Some(code));
+        assert_eq!(extract_transfer_code("HTPXYZ no code"), None);
+    }
+
+    #[test]
+    fn sanitize_vietnamese() {
+        assert_eq!(
+            sanitize_memo("Thanh toán đơn hàng #123 - Phở Tuệ", 25),
+            "Thanh toan don hang 123 P"
+        );
+    }
+
+    #[test]
+    fn resolves_bank_bins() {
+        assert_eq!(resolve_bank_bin("MBBank"), Some("970422"));
+        assert_eq!(resolve_bank_bin("vietcombank"), Some("970436"));
+        assert_eq!(resolve_bank_bin("970407"), Some("970407"));
+        assert_eq!(resolve_bank_bin("unknown"), None);
+    }
+
+    #[test]
+    fn hmac_helpers() {
+        // RFC 4231 test case 2
+        assert_eq!(
+            hmac_sha256_hex("Jefe", "what do ya want for nothing?").unwrap(),
+            "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
+        );
+        assert!(secure_eq("abc", "abc"));
+        assert!(!secure_eq("abc", "abd"));
+    }
+
+    #[test]
+    fn resolves_hosted_url() {
+        let sandbox = "https://sandbox";
+        let production = "https://production";
+        assert_eq!(resolve_hosted_payment_url(None, None, sandbox, production), sandbox);
+        assert_eq!(
+            resolve_hosted_payment_url(None, Some(false), sandbox, production),
+            production
+        );
+        let meta = hyperswitch_masking::Secret::new(serde_json::json!({"environment": "live"}));
+        assert_eq!(
+            resolve_hosted_payment_url(Some(&meta), Some(true), sandbox, production),
+            production
+        );
+        let meta = hyperswitch_masking::Secret::new(serde_json::json!({"payment_url": "https://x"}));
+        assert_eq!(
+            resolve_hosted_payment_url(Some(&meta), None, sandbox, production),
+            "https://x"
+        );
+    }
+
+    #[test]
+    fn vn_date_formats() {
+        let dt = time::macros::datetime!(2026-01-05 03:04:05 UTC);
+        let vn = to_vn(dt);
+        assert_eq!(format_yyyymmddhhmmss(vn), "20260105100405");
+        assert_eq!(format_yymmdd(vn), "260105");
+    }
+}
