+/// Lower-case hex HMAC-SHA256
+pub fn hmac_sha256_hex(
+    key: &str,
+    message: &str,
+) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+    crypto::HmacSha256
+        .sign_message(key.as_bytes(), message.as_bytes())
+        .map(hex::encode)
+        .change_context(errors::ConnectorError::RequestEncodingFailed)
+}
+
+/// Lower-case hex HMAC-SHA512
+pub fn hmac_sha512_hex(
+    key: &str,
+    message: &str,
+) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+    crypto::HmacSha512
+        .sign_message(key.as_bytes(), message.as_bytes())
+        .map(hex::encode)
+        .change_context(errors::ConnectorError::RequestEncodingFailed)
+}
+
+/// Base64 HMAC-SHA1
+pub fn hmac_sha1_base64(
+    key: &str,
+    message: &str,
+) -> Result<String, error_stack::Report<errors::ConnectorError>> {
+    crypto::HmacSha1
+        .sign_message(key.as_bytes(), message.as_bytes())
+        .map(|bytes| base64::engine::general_purpose::STANDARD.encode(bytes))
+        .change_context(errors::ConnectorError::RequestEncodingFailed)
+}
