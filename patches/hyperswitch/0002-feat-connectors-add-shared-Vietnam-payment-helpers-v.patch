+/// Data required to build a dynamic VietQR (NAPAS 247 "to account" transfer)
+#[derive(Debug, Clone)]
+pub struct VietQrData<'a> {
+    pub bank_bin: &'a str,
+    pub account_number: &'a str,
+    pub amount: Option<i64>,
+    pub memo: Option<&'a str>,
+}
+
+fn tlv(tag: &str, value: &str) -> String {
+    format!("{tag}{:02}{value}", value.len())
+}
+
+/// CRC16/CCITT-FALSE (poly 0x1021, init 0xFFFF), as required by EMVCo QR
+pub fn crc16_ccitt(data: &[u8]) -> u16 {
+    data.iter().fold(0xFFFFu16, |crc, byte| {
+        (0..8).fold(crc ^ (u16::from(*byte) << 8), |crc, _| {
+            if crc & 0x8000 != 0 {
+                (crc << 1) ^ 0x1021
+            } else {
+                crc << 1
+            }
+        })
+    })
+}
+
+/// Build the EMVCo payload string of a VietQR
+pub fn build_vietqr_payload(data: &VietQrData<'_>) -> String {
+    let beneficiary = tlv("00", data.bank_bin) + &tlv("01", data.account_number);
+    let merchant_account =
+        tlv("00", "A000000727") + &tlv("01", &beneficiary) + &tlv("02", "QRIBFTTA");
+    let mut payload = tlv("00", "01");
+    payload += &tlv(
+        "01",
+        if data.amount.is_some() { "12" } else { "11" },
+    );
+    payload += &tlv("38", &merchant_account);
+    payload += &tlv("53", "704");
+    if let Some(amount) = data.amount {
+        payload += &tlv("54", &amount.to_string());
+    }
+    payload += &tlv("58", "VN");
+    if let Some(memo) = data.memo.filter(|memo| !memo.is_empty()) {
+        payload += &tlv("62", &tlv("08", memo));
+    }
+    payload += "6304";
+    let crc = crc16_ccitt(payload.as_bytes());
+    format!("{payload}{crc:04X}")
+}
+
+/// Build the `connector_metadata` JSON for a QR next action (rendered by the SDK).
+pub fn qr_code_metadata(
+    raw_qr_data: String,
+    qr_code_url: Option<url::Url>,
+    display_to_timestamp: Option<i64>,
+) -> Result<serde_json::Value, error_stack::Report<errors::ConnectorError>> {
+    let image = QrImage::new_from_data(raw_qr_data.clone())
+        .change_context(errors::ConnectorError::ResponseHandlingFailed)?;
+    let image_data_url = url::Url::parse(image.data.as_str())
+        .change_context(errors::ConnectorError::ResponseHandlingFailed)?;
+    QrCodeInformation::QrCodeUrl {
+        image_data_url,
+        qr_code_url,
+        display_to_timestamp,
+        expiry_type: None,
+        raw_qr_data: Some(raw_qr_data),
+    }
+    .encode_to_value()
+    .change_context(errors::ConnectorError::ResponseHandlingFailed)
+}
