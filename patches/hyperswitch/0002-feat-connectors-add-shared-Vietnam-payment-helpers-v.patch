+/// Vietnam standard time offset (GMT+7)
+pub const VN_UTC_OFFSET_HOURS: i8 = 7;
+
+/// Prefix of HiTechPay generated bank-transfer codes, e.g. `HTP1A2B3C4D5E6F`
+pub const TRANSFER_CODE_PREFIX: &str = "HTP";
+
+const TRANSFER_CODE_HASH_LEN: usize = 12;
+
+/// Current time in Vietnam (GMT+7)
+pub fn now_vn() -> OffsetDateTime {
+    let offset = UtcOffset::from_hms(VN_UTC_OFFSET_HOURS, 0, 0).unwrap_or(UtcOffset::UTC);
+    OffsetDateTime::now_utc().to_offset(offset)
+}
+
+/// Convert a time to Vietnam time (GMT+7)
+pub fn to_vn(datetime: OffsetDateTime) -> OffsetDateTime {
+    let offset = UtcOffset::from_hms(VN_UTC_OFFSET_HOURS, 0, 0).unwrap_or(UtcOffset::UTC);
+    datetime.to_offset(offset)
+}
+
+/// `yyyyMMddHHmmss`, used by VNPay
+pub fn format_yyyymmddhhmmss(datetime: OffsetDateTime) -> String {
+    format!(
+        "{:04}{:02}{:02}{:02}{:02}{:02}",
+        datetime.year(),
+        u8::from(datetime.month()),
+        datetime.day(),
+        datetime.hour(),
+        datetime.minute(),
+        datetime.second()
+    )
+}
+
+/// `yyMMdd`, used by ZaloPay `app_trans_id` / `m_refund_id`
+pub fn format_yymmdd(datetime: OffsetDateTime) -> String {
+    format!(
+        "{:02}{:02}{:02}",
+        datetime.year().rem_euclid(100),
+        u8::from(datetime.month()),
+        datetime.day()
+    )
+}
