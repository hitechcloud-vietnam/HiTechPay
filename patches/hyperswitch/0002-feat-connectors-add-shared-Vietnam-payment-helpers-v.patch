+/// Resolve the hosted payment page URL of a redirect gateway (VNPay, Viettel Money).
+///
+/// Order of precedence:
+/// 1. `payment_url` in the connector account metadata
+/// 2. `environment` in the connector account metadata (`production`/`live` or `sandbox`/`test`)
+/// 3. the connector account `test_mode` flag (`Some(false)` → production, otherwise sandbox)
+pub fn resolve_hosted_payment_url(
+    connector_meta_data: Option<&hyperswitch_masking::Secret<serde_json::Value>>,
+    test_mode: Option<bool>,
+    sandbox_url: &str,
+    production_url: &str,
+) -> String {
+    use hyperswitch_masking::PeekInterface;
+    let metadata = connector_meta_data.map(|meta| meta.peek().clone());
+    let get = |key: &str| {
+        metadata
+            .as_ref()
+            .and_then(|meta| meta.get(key))
+            .and_then(|value| value.as_str())
+            .map(|value| value.trim().to_string())
+            .filter(|value| !value.is_empty())
+    };
+    if let Some(url) = get("payment_url") {
+        return url;
+    }
+    let is_production = match get("environment").map(|env| env.to_ascii_lowercase()) {
+        Some(env) if env == "production" || env == "live" || env == "prod" => true,
+        Some(_) => false,
+        None => test_mode == Some(false),
+    };
+    if is_production {
+        production_url.to_string()
+    } else {
+        sandbox_url.to_string()
+    }
+}
