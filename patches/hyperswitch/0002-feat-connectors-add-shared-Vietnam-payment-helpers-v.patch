+/// Replace Vietnamese diacritics with ASCII and keep only characters accepted by
+/// VN gateways / bank transfer memos (`A-Z a-z 0-9` and space). Truncates to `max_len`.
+pub fn sanitize_memo(input: &str, max_len: usize) -> String {
+    let ascii: String = input.chars().map(strip_vietnamese_diacritic).collect();
+    let cleaned: String = ascii
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() { c } else { ' ' })
+        .collect();
+    let collapsed = cleaned.split_whitespace().collect::<Vec<_>>().join(" ");
+    collapsed.chars().take(max_len).collect::<String>().trim().to_string()
+}
+
+fn strip_vietnamese_diacritic(c: char) -> char {
+    const GROUPS: &[(&str, char)] = &[
+        ("àáạảãâầấậẩẫăằắặẳẵ", 'a'),
+        ("ÀÁẠẢÃÂẦẤẬẨẪĂẰẮẶẲẴ", 'A'),
+        ("èéẹẻẽêềếệểễ", 'e'),
+        ("ÈÉẸẺẼÊỀẾỆỂỄ", 'E'),
+        ("ìíịỉĩ", 'i'),
+        ("ÌÍỊỈĨ", 'I'),
+        ("òóọỏõôồốộổỗơờớợởỡ", 'o'),
+        ("ÒÓỌỎÕÔỒỐỘỔỖƠỜỚỢỞỠ", 'O'),
+        ("ùúụủũưừứựửữ", 'u'),
+        ("ÙÚỤỦŨƯỪỨỰỬỮ", 'U'),
+        ("ỳýỵỷỹ", 'y'),
+        ("ỲÝỴỶỸ", 'Y'),
+        ("đ", 'd'),
+        ("Đ", 'D'),
+    ];
+    GROUPS
+        .iter()
+        .find(|(set, _)| set.contains(c))
+        .map(|(_, replacement)| *replacement)
+        .unwrap_or(c)
+}
+
+/// Deterministic, bank-memo-safe transfer code derived from the payment reference.
+/// Example: `HTP4F1C0A9B22D7`
+pub fn transfer_code(reference: &str) -> String {
+    let digest = sha2::Sha256::digest(reference.as_bytes());
+    let hex = hex::encode_upper(digest);
+    format!(
+        "{TRANSFER_CODE_PREFIX}{}",
+        &hex[..TRANSFER_CODE_HASH_LEN]
+    )
+}
+
+/// Find a HiTechPay transfer code inside a free-text bank transfer description.
+/// Banks may strip spaces or lowercase the memo, so matching is case-insensitive.
+pub fn extract_transfer_code(content: &str) -> Option<String> {
+    let upper = content.to_ascii_uppercase();
+    let bytes = upper.as_bytes();
+    let code_len = TRANSFER_CODE_PREFIX.len() + TRANSFER_CODE_HASH_LEN;
+    upper.match_indices(TRANSFER_CODE_PREFIX).find_map(|(idx, _)| {
+        let candidate = bytes.get(idx..idx + code_len)?;
+        let hash_part = &candidate[TRANSFER_CODE_PREFIX.len()..];
+        let is_valid = hash_part
+            .iter()
+            .all(|b| b.is_ascii_digit() || (b'A'..=b'F').contains(b));
+        is_valid.then(|| String::from_utf8_lossy(candidate).to_string())
+    })
+}
+
+/// Resolve a NAPAS bank BIN from a short name, VietQR code or a BIN itself.
+pub fn resolve_bank_bin(bank: &str) -> Option<&'static str> {
+    let key = bank.trim().to_ascii_uppercase().replace([' ', '-', '_'], "");
+    if key.len() == 6 && key.chars().all(|c| c.is_ascii_digit()) {
+        return BANK_BINS
+            .iter()
+            .find(|(bin, _)| *bin == key)
+            .map(|(bin, _)| *bin);
+    }
+    BANK_BINS
+        .iter()
+        .find(|(_, aliases)| aliases.iter().any(|alias| *alias == key))
+        .map(|(bin, _)| *bin)
+}
