Subject: [PATCH 4/4] test(e2e): expect HiTechPay strings in Playwright
 assertions

The white-label (tools/whitelabel.py) rebrands user-visible dashboard
strings, so the e2e assertions now expect what the UI renders:
- sign-up header "Welcome to HiTechPay"
- maintenance screen "HiTechPay Dashboard is under maintenance"
- production-access placeholder "Eg: HiTechPay Pvt Ltd"
- "HiTechPay Error Description" payment attribute
- manual-review banner "HiTechPay received an anomalous response ..."
- connector label help text "... on your HiTechPay dashboard ..."

E-mail subjects (entity_name from the router config), input values and
demo identifiers are unchanged.

diff --git a/playwright-tests/e2e/1-auth/auth.spec.ts b/playwright-tests/e2e/1-auth/auth.spec.ts
index 83bfcd9..cfc820b 100644
--- a/playwright-tests/e2e/1-auth/auth.spec.ts
+++ b/playwright-tests/e2e/1-auth/auth.spec.ts
@@ -24,7 +24,7 @@ test.describe.serial("Sign up", () => {
 
     await visitSignupPage(page);
 
-    await expect(signupPage.headerText).toContainText("Welcome to Hyperswitch");
+    await expect(signupPage.headerText).toContainText("Welcome to HiTechPay");
     await expect(signupPage.signInLink).toContainText("Sign in");
     await expect(signupPage.emailInput).toHaveAttribute(
       "placeholder",
@@ -206,7 +206,7 @@ test.describe.serial("Sign in", () => {
     await signinPage.signUpLink.click();
     await expect(page).toHaveURL(/.*register/);
 
-    await expect(signupPage.headerText).toContainText("Welcome to Hyperswitch");
+    await expect(signupPage.headerText).toContainText("Welcome to HiTechPay");
     await signupPage.signInLink.click();
 
     await expect(page).toHaveURL(/.*login/);
@@ -1043,13 +1043,13 @@ test.describe("Maintenance mode and Down time", () => {
     await page.goto("/");
 
     await expect(
-      page.getByText("Hyperswitch Control Center is under maintenance", {
+      page.getByText("HiTechPay Dashboard is under maintenance", {
         exact: true,
       }),
     ).toBeVisible();
     await expect(
       page.getByText(
-        "Hyperswitch Control Center is under maintenance will be back in an hour",
+        "HiTechPay Dashboard is under maintenance will be back in an hour",
       ),
     ).toBeVisible();
     await expect(page.getByText("Hey there, Welcome back!")).not.toBeVisible();
