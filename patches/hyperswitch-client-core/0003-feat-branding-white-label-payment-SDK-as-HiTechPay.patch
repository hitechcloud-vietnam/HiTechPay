diff --git a/src/components/elements/HyperSwitchBranding.res b/src/components/elements/HyperSwitchBranding.res
index 2c50be7..6c54361 100644
--- a/src/components/elements/HyperSwitchBranding.res
+++ b/src/components/elements/HyperSwitchBranding.res
@@ -1,22 +1,35 @@
 open ReactNative
 open Style
+
+// HiTechPay: the "Powered by" footer is rendered from the (rebranded, localised) poweredBy string
+// instead of the upstream "Powered by Hyperswitch" image served by the asset CDN. The module name
+// is kept for compatibility.
 @react.component
 let make = () => {
   let (nativeProp, _) = React.useContext(NativePropContext.nativePropContext)
-  let (themeType, _) = React.useContext(ThemeContext.themeContext)
+  let localeObject = GetLocale.useGetLocalObj()
+
+  let poweredBy = localeObject.poweredBy->HiTechPayLocale.rebrand
+  let brand = HiTechPayLocale.brandName
+  let (prefix, suffix) = switch poweredBy->String.indexOfOpt(brand) {
+  | Some(index) => (
+      poweredBy->String.slice(~start=0, ~end=index),
+      poweredBy->String.sliceToEnd(~start=index + brand->String.length),
+    )
+  | None => (poweredBy ++ " ", "")
+  }
 
   <>
     <Space />
     <UIUtils.RenderIf condition={!nativeProp.configuration.disableBranding}>
       <View style={s({alignItems: #center})}>
-        <Icon
-          name={switch themeType {
-          | Light(_) => "hyperswitch"
-          | Dark(_) => "hyperswitchdark"
-          }}
-          width=180.
-          height=20.
-        />
+        <TextWrapper textType={ModalTextLight} overrideStyle=Some(s({fontSize: 12., opacity: 0.6}))>
+          {<>
+            {React.string(prefix)}
+            <Text style={s({fontWeight: #700})}> {React.string(brand)} </Text>
+            {React.string(suffix)}
+          </>}
+        </TextWrapper>
       </View>
     </UIUtils.RenderIf>
   </>
