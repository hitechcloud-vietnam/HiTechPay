diff --git a/src/utility/locales/HiTechPayLocale.res b/src/utility/locales/HiTechPayLocale.res
index 9de3e9c..c45782e 100644
--- a/src/utility/locales/HiTechPayLocale.res
+++ b/src/utility/locales/HiTechPayLocale.res
@@ -5,7 +5,8 @@
 // HiTechPay keeps every change inside this repository instead:
 //   - the Vietnamese locale is bundled (VietnameseLocale.res) and selected for `vi` / `vi-VN`;
 //   - strings that the upstream record does not have (display names of the Vietnamese payment
-//     methods, QR payment screen) are provided here for every supported locale.
+//     methods, QR payment screen) are provided here for every supported locale;
+//   - user-visible "Hyperswitch" brand mentions in fetched locale strings are rewritten.
 
 let brandName = "HiTechPay"
 
@@ -192,3 +193,33 @@ let vietnameseQrStrings = {
 
 let getQrStrings = (localeCode: string) =>
   isVietnamese(localeCode) ? vietnameseQrStrings : englishQrStrings
+
+// ---------------------------------------------------------------------------------------------
+// White-label: rewrite user-visible brand mentions in fetched locale strings.
+// The BECS (Australia) mandate names a legal entity and is kept unchanged.
+// ---------------------------------------------------------------------------------------------
+
+let rebrand = (str: string) =>
+  str
+  ->String.replaceAll("Hyperswitch", brandName)
+  ->String.replaceAll("HyperSwitch", brandName)
+  ->String.replaceAll("هيبيرسويتش", brandName)
+  ->String.replaceAll("ハイパースイッチ", brandName)
+
+let keysNotRebranded = ["becsDebitTerms"]
+
+let rebrandLocaleJson = (json: JSON.t) =>
+  switch json->JSON.Decode.object {
+  | Some(dict) =>
+    dict
+    ->Dict.toArray
+    ->Array.map(((key, value)) =>
+      switch (keysNotRebranded->Array.includes(key), value->JSON.Decode.string) {
+      | (false, Some(str)) => (key, str->rebrand->JSON.Encode.string)
+      | _ => (key, value)
+      }
+    )
+    ->Dict.fromArray
+    ->JSON.Encode.object
+  | None => json
+  }
