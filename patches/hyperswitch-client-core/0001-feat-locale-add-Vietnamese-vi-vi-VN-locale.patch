diff --git a/src/utility/locales/HiTechPayLocale.res b/src/utility/locales/HiTechPayLocale.res
new file mode 100644
index 0000000..21514cb
--- /dev/null
+++ b/src/utility/locales/HiTechPayLocale.res
@@ -0,0 +1,186 @@
+// HiTechPay locale helpers.
+//
+// The upstream locale record (LocaleDataType.localeStrings) and its JSON files live in the shared
+// `shared-code` (hyperswitch-sdk-utils) submodule and are fetched from the asset CDN at runtime.
+// HiTechPay keeps every change inside this repository instead:
+//   - the Vietnamese locale is bundled (VietnameseLocale.res) and selected for `vi` / `vi-VN`;
+//   - strings that the upstream record does not have (display names of the Vietnamese payment
+//     methods, QR payment screen) are provided here for every supported locale.
+
+let brandName = "HiTechPay"
+
+let normalizeLocaleCode = (code: string) =>
+  code->String.trim->String.toLowerCase->String.replaceAll("_", "-")
+
+let isVietnamese = (code: string) => {
+  let normalized = code->normalizeLocaleCode
+  normalized == "vi" || normalized->String.startsWith("vi-")
+}
+
+// Language key of the tables below for a configured locale code (e.g. "vi-VN" -> "vi").
+let languageKey = (code: string) => {
+  switch code->normalizeLocaleCode {
+  | "zh-hant" | "zh-tw" | "zh-hk" | "zh-mo" | "tr-zh" => "zh-hant"
+  | "is" | "ls" => "is"
+  | "no" | "nb" | "nn" => "nb"
+  | "ni-be" | "nl-be" => "nl"
+  | normalized => normalized->String.split("-")->Array.get(0)->Option.getOr("en")
+  }
+}
+
+// Value sent as `browser_info.language`.
+let browserLanguage = (~locale: option<LocaleDataType.localeTypes>, ~localeCode: string) =>
+  isVietnamese(localeCode) ? "vi-VN" : LocaleDataType.localeTypeToString(locale)
+
+// ---------------------------------------------------------------------------------------------
+// Payment method display names (HiTechPay Vietnamese connectors), one entry per locale.
+// ---------------------------------------------------------------------------------------------
+
+type paymentMethodStrings = {
+  vietQr: string,
+  momoAtm: string,
+  localBankRedirect: string,
+  momo: string,
+}
+
+let englishPaymentMethodStrings = {
+  vietQr: "VietQR",
+  momoAtm: "MoMo ATM",
+  localBankRedirect: "Domestic bank",
+  momo: "MoMo",
+}
+
+let withLocalBank = localBankRedirect => {...englishPaymentMethodStrings, localBankRedirect}
+
+let paymentMethodStringsByLanguage: array<(string, paymentMethodStrings)> = [
+  ("en", englishPaymentMethodStrings),
+  (
+    "vi",
+    {
+      vietQr: "VietQR",
+      momoAtm: "MoMo ATM",
+      localBankRedirect: "Ngân hàng nội địa",
+      momo: "Ví MoMo",
+    },
+  ),
+  ("ar", withLocalBank("بنك محلي")),
+  ("bs", withLocalBank("Domaća banka")),
+  ("ca", withLocalBank("Banc nacional")),
+  ("cs", withLocalBank("Tuzemská banka")),
+  ("cy", withLocalBank("Banc domestig")),
+  ("da", withLocalBank("Indenlandsk bank")),
+  ("de", withLocalBank("Inländische Bank")),
+  ("el", withLocalBank("Εγχώρια τράπεζα")),
+  ("es", withLocalBank("Banco nacional")),
+  ("et", withLocalBank("Kodumaine pank")),
+  ("fi", withLocalBank("Kotimainen pankki")),
+  ("fr", withLocalBank("Banque locale")),
+  ("he", withLocalBank("בנק מקומי")),
+  ("is", withLocalBank("Innlendur banki")),
+  ("it", withLocalBank("Banca locale")),
+  ("ja", withLocalBank("国内銀行")),
+  ("lt", withLocalBank("Vietinis bankas")),
+  ("ms", withLocalBank("Bank tempatan")),
+  ("nb", withLocalBank("Innenlandsk bank")),
+  ("nl", withLocalBank("Binnenlandse bank")),
+  ("pl", withLocalBank("Bank krajowy")),
+  ("pt", withLocalBank("Banco nacional")),
+  ("ru", withLocalBank("Местный банк")),
+  ("sk", withLocalBank("Tuzemská banka")),
+  ("sv", withLocalBank("Inhemsk bank")),
+  ("tr", withLocalBank("Yerel banka")),
+  ("zh", withLocalBank("国内银行")),
+  ("zh-hant", withLocalBank("國內銀行")),
+]
+
+let paymentMethodStringsDict = paymentMethodStringsByLanguage->Dict.fromArray
+
+let getPaymentMethodStrings = (localeCode: string) =>
+  paymentMethodStringsDict
+  ->Dict.get(localeCode->languageKey)
+  ->Option.getOr(englishPaymentMethodStrings)
+
+let hiTechPayPaymentMethodTypes = ["viet_qr", "momo_atm", "local_bank_redirect", "momo"]
+
+let getPaymentMethodDisplayName = (~localeCode: string, paymentMethodType: string) => {
+  let strings = getPaymentMethodStrings(localeCode)
+  switch paymentMethodType {
+  | "viet_qr" => strings.vietQr
+  | "momo_atm" => strings.momoAtm
+  | "local_bank_redirect" => strings.localBankRedirect
+  | "momo" => strings.momo
+  | other => other->CommonUtils.getDisplayName
+  }
+}
+
+let useGetPaymentMethodDisplayName = () => {
+  let (nativeProp, _) = React.useContext(NativePropContext.nativePropContext)
+  paymentMethodType =>
+    getPaymentMethodDisplayName(~localeCode=nativeProp.configuration.localeCode, paymentMethodType)
+}
+
+// Tabs and buttons use the display name as icon name; map every (localised) label and payment
+// method type of the HiTechPay methods to a bundled icon key.
+let iconKeyByName = {
+  let dict = Dict.make()
+  let add = (name, key) => dict->Dict.set(name->normalizeLocaleCode, key)
+  paymentMethodStringsByLanguage->Array.forEach(((_, strings)) => {
+    add(strings.vietQr, "vietqr")
+    add(strings.momoAtm, "momoatm")
+    add(strings.localBankRedirect, "localbankredirect")
+    add(strings.momo, "momo")
+  })
+  add("viet_qr", "vietqr")
+  add("momo_atm", "momoatm")
+  add("local_bank_redirect", "localbankredirect")
+  add("momo", "momo")
+  dict
+}
+
+let getIconKey = (name: string) => iconKeyByName->Dict.get(name->normalizeLocaleCode)
+
+// ---------------------------------------------------------------------------------------------
+// QR payment screen (next_action.type = "qr_code_information").
+// ---------------------------------------------------------------------------------------------
+
+type qrStrings = {
+  qrTitle: string,
+  qrInstructions: string,
+  qrExpiresIn: string,
+  qrExpired: string,
+  qrCheckStatus: string,
+  qrCheckingStatus: string,
+  qrNotReceived: string,
+  qrCancel: string,
+  qrCopyCode: string,
+  qrCopied: string,
+}
+
+let englishQrStrings = {
+  qrTitle: "Scan to pay",
+  qrInstructions: "Open your banking or e-wallet app and scan this QR code to complete the payment.",
+  qrExpiresIn: "QR code expires in",
+  qrExpired: "The QR code has expired. Please try again.",
+  qrCheckStatus: "I have completed the payment",
+  qrCheckingStatus: "Checking payment status...",
+  qrNotReceived: "We have not received your payment yet. Please wait a moment and check again.",
+  qrCancel: "Cancel",
+  qrCopyCode: "Copy QR code data",
+  qrCopied: "Copied",
+}
+
+let vietnameseQrStrings = {
+  qrTitle: "Quét mã để thanh toán",
+  qrInstructions: "Mở ứng dụng ngân hàng hoặc ví điện tử và quét mã QR này để hoàn tất thanh toán.",
+  qrExpiresIn: "Mã QR hết hạn sau",
+  qrExpired: "Mã QR đã hết hạn. Vui lòng thử lại.",
+  qrCheckStatus: "Tôi đã thanh toán",
+  qrCheckingStatus: "Đang kiểm tra trạng thái thanh toán...",
+  qrNotReceived: "Chúng tôi chưa nhận được thanh toán của bạn. Vui lòng đợi giây lát rồi kiểm tra lại.",
+  qrCancel: "Hủy",
+  qrCopyCode: "Sao chép dữ liệu mã QR",
+  qrCopied: "Đã sao chép",
+}
+
+let getQrStrings = (localeCode: string) =>
+  isVietnamese(localeCode) ? vietnameseQrStrings : englishQrStrings
