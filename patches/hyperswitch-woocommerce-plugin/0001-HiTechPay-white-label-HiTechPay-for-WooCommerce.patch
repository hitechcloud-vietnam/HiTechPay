+/**
+ * Number of minor units per major unit, following Hyperswitch's currency table
+ * (VND, JPY, KRW, ... are zero-decimal; BHD, KWD, ... are three-decimal).
+ */
+function hyperswitch_currency_multiplier( $currency ) {
+	$currency = strtoupper( (string) $currency );
+	$zero_decimal = array( 'BIF', 'CLP', 'DJF', 'GNF', 'IRR', 'JPY', 'KMF', 'KRW', 'MGA', 'PYG', 'RWF', 'UGX', 'VND', 'VUV', 'XAF', 'XOF', 'XPF' );
+	$three_decimal = array( 'BHD', 'IQD', 'JOD', 'KWD', 'LYD', 'OMR', 'TND' );
+	if ( in_array( $currency, $zero_decimal, true ) ) {
+		return 1;
+	}
+	if ( in_array( $currency, $three_decimal, true ) ) {
+		return 1000;
+	}
+	return 100;
+}
+
+/** Convert a WooCommerce (major unit) amount to the API's minor-unit integer. */
+function hyperswitch_to_minor_units( $amount, $currency ) {
+	return (int) round( (float) $amount * hyperswitch_currency_multiplier( $currency ) );
+}
+
+/** Convert an API minor-unit integer back to a WooCommerce (major unit) amount. */
+function hyperswitch_from_minor_units( $amount, $currency ) {
+	return (float) $amount / hyperswitch_currency_multiplier( $currency );
+}
