@@ -0,0 +1,377 @@
+# Vietnamese translation for HiTechPay for WooCommerce.
+# Copyright (C) 2026 Pho Tue Software Solutions JSC & HiTechCloud Vietnam
+# This file is distributed under the same license as the plugin (GPLv2 or later).
+msgid ""
+msgstr ""
+"Project-Id-Version: HiTechPay for WooCommerce 1.6.1-hitechpay.1\n"
+"Report-Msgid-Bugs-To: support@hitechpay.vn\n"
+"POT-Creation-Date: 2026-10-14 00:00+0700\n"
+"PO-Revision-Date: 2026-10-14 00:00+0700\n"
+"Last-Translator: HiTechPay <support@hitechpay.vn>\n"
+"Language-Team: Vietnamese\n"
+"Language: vi\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=1; plural=0;\n"
+"X-Domain: hitechpay-woocommerce\n"
+
+#. Plugin Name of the plugin
+#: hyperswitch-checkout.php
+msgid "HiTechPay for WooCommerce"
+msgstr "HiTechPay cho WooCommerce"
+
+#. Plugin URI of the plugin
+#: hyperswitch-checkout.php
+msgid "https://hitechpay.vn/"
+msgstr "https://hitechpay.vn/"
+
+#. Description of the plugin
+#: hyperswitch-checkout.php
+msgid "Accept VietQR, MoMo, ZaloPay, VNPAY and card payments on WooCommerce with HiTechPay, the unified payment gateway for Vietnamese businesses."
+msgstr "Nhận thanh toán VietQR, MoMo, ZaloPay, VNPAY và thẻ trên WooCommerce với HiTechPay — cổng thanh toán hợp nhất cho doanh nghiệp Việt Nam."
+
+#. Author of the plugin
+#: hyperswitch-checkout.php
+msgid "Pho Tue Software Solutions JSC & HiTechCloud Vietnam"
+msgstr "Pho Tue Software Solutions JSC & HiTechCloud Vietnam"
+
+#: hyperswitch-checkout.php:115 hyperswitch-checkout.php:290
+msgid "HiTechPay"
+msgstr "HiTechPay"
+
+#: hyperswitch-checkout.php:116
+msgid "Allow customers to securely pay via HiTechPay (VietQR, MoMo, ZaloPay, VNPAY, cards)"
+msgstr "Cho phép khách hàng thanh toán an toàn qua HiTechPay (VietQR, MoMo, ZaloPay, VNPAY, thẻ)"
+
+#: hyperswitch-checkout.php:198
+msgid "Settings"
+msgstr "Cài đặt"
+
+#: hyperswitch-checkout.php:221
+msgid "Thank you for shopping with us. Please note that your payment has been authorized and can now be captured by the merchant. Kindly check the status of your order after some time."
+msgstr "Cảm ơn bạn đã mua hàng. Khoản thanh toán của bạn đã được cấp phép và đang chờ cửa hàng xác nhận thu tiền. Vui lòng kiểm tra lại trạng thái đơn hàng sau ít phút."
+
+#: hyperswitch-checkout.php:223
+msgid "Thank you for shopping with us. Please note that your payment is currently being processed. Kindly check the status of your order after some time."
